@page
@model ErrorModel
@{
    ViewData["Title"] = Localizer["ERROR_PAGE_TITLE"];
    var title = ViewData["error_title"]?.ToString();
}

<div class="fc-auth__form" style="flex: 1 0 auto; padding-top: 64px; padding-bottom: 64px">
    <div class="fc-auth__box fc-auth__box--card">
        <span class="fc-icon-tile" aria-hidden="true"><svg class="fc-icon" style="width: 26px; height: 26px" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v6M12 16.5h.01"></path></svg></span>
        <h1 style="font-size: 30px">@(string.IsNullOrWhiteSpace(title) ? Localizer["FC_ERROR_TITLE"].Value : title)</h1>
        <p class="fc-muted">@Localizer["FC_ERROR_TEXT"]</p>
        <div class="fc-btn-row">
            <a asp-area="" asp-page="/Index" class="fc-btn fc-btn--primary">@Localizer["FC_BACK_TO_SITE"]</a>
            <a asp-area="" asp-page="/Contact" class="fc-btn fc-btn--quiet">@Localizer["NAV_CONTACT"]</a>
        </div>
        @if (!string.IsNullOrWhiteSpace(Model.ExceptionMessage) || !string.IsNullOrWhiteSpace(Model.RequestId))
        {
            <details class="fc-small fc-muted">
                <summary style="cursor: pointer; font-weight: 700">@Localizer["FC_TECHNICAL_DETAILS"]</summary>
                <p style="margin-top: 8px"><strong>@Localizer["ERROR_LABEL_MESSAGE"]</strong> @Model.ExceptionMessage</p>
                <p><strong>@Localizer["ERROR_LABEL_ID"]</strong> <code>@Model.RequestId</code></p>
            </details>
        }
    </div>
</div>
