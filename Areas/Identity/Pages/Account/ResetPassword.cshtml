@page
@model ResetPasswordModel
@{
    ViewData["Title"] = "Reset Your Password";
}
<head>
    <title>Reset Your Password</title>
    <link rel="stylesheet" integrity="sha256-F0H03/JY0AiRnWLu2uR3hqfsWg0n5LpkvZfNx8mUHWY=" href="~/css2/Login.css" asp-append-version="true" />
</head>
<style nonce="@HttpContextAccessor.HttpContext?.Items["CSP-Style-Nonce"]">
    .mb-3, .h3, h3 {
        color: white;
    }

    footer {
        position: fixed;
    }

    #wrapper {
        width: calc(30.0rem + 1.0vw);
    }
</style>

<div class="container-fluid text-center">
    <form method="post" class="form-signin">
        <!-- AntiforgeryToken -->
        @Html.AntiForgeryToken()

        <img class="mb-4" src="~/img/logo.png" alt="ForestChurches Logo" width="300" height="200" />
        <partial name="_StatusMessage" model="Model.StatusMessage" />
        <h1 class="h3 mb-3 font-weight-normal">Reset your password</h1>

        <!-- Inputs -->
        <label asp-for="Input.Email" class="sr-only">Email address</label>
        <input asp-for="Input.Email" type="email" autocomplete="username" aria-required="true" class="form-control" placeholder="Email address" required="" autofocus="" />
        <span asp-validation-for="Input.Email" class="text-danger"></span>

        <label asp-for="Input.Password" class="sr-only">New Password</label>
        <input asp-for="Input.Password" type="password" autocomplete="new-password" aria-required="true" class="form-control" placeholder="New Password" required="" />
        <span asp-validation-for="Input.Password" class="text-danger"></span>

        <label asp-for="Input.ConfirmPassword" class="sr-only">Confirm Password</label>
        <input asp-for="Input.ConfirmPassword" type="password" autocomplete="new-password" aria-required="true" class="form-control" placeholder="Confirm Password" required="" />
        <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>

        <input asp-for="Input.Code" type="hidden" />

        <div class="form-container">
            <button type="submit" class="full-width btn btn-lg btn-success btn-block">Reset</button>
        </div>
        <div>
            <p>
                <a id="login-link" asp-page="./Login">Back to Login</a>
            </p>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}