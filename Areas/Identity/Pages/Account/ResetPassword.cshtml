@page
@model ResetPasswordModel
@{
    ViewData["Title"] = Localizer["FC_CHOOSE_NEW_PASSWORD"];
}
<div class="fc-auth__form" style="flex: 1 0 auto; padding-top: 64px; padding-bottom: 64px">
    <div class="fc-auth__box fc-auth__box--card">
        <span class="fc-icon-tile" aria-hidden="true"><svg class="fc-icon" style="width: 26px; height: 26px" viewBox="0 0 24 24"><rect x="5" y="11" width="14" height="10" rx="2"></rect><path d="M8 11V7a4 4 0 0 1 8 0v4"></path></svg></span>
        <h1 style="font-size: 30px">@Localizer["FC_CHOOSE_NEW_PASSWORD"]</h1>
        <partial name="_StatusMessage" model="Model.StatusMessage" />
        <form method="post" class="fc-stack">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <input asp-for="Input.Code" type="hidden" />
            <div class="fc-field">
                <label class="fc-label" asp-for="Input.Email">@Localizer["LOGIN_EMAIL_LABEL"]</label>
                <input class="fc-input" asp-for="Input.Email" type="email" autocomplete="username" aria-required="true" required autofocus />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>
            <div class="fc-field">
                <label class="fc-label" asp-for="Input.Password">@Localizer["TAG_NEW_PWD"]</label>
                <input class="fc-input" asp-for="Input.Password" type="password" autocomplete="new-password" aria-required="true" aria-describedby="pw-hint" required />
                <span id="pw-hint" class="fc-hint">@Localizer["FC_PASSWORD_HINT"]</span>
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>
            <div class="fc-field">
                <label class="fc-label" asp-for="Input.ConfirmPassword">@Localizer["FC_CONFIRM_NEW_PASSWORD"]</label>
                <input class="fc-input" asp-for="Input.ConfirmPassword" type="password" autocomplete="new-password" aria-required="true" required />
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
            </div>
            <button type="submit" class="fc-btn fc-btn--primary fc-btn--lg fc-btn--block">@Localizer["FC_UPDATE_PASSWORD"]</button>
        </form>
        <a id="login-link" asp-page="./Login" class="fc-small" style="font-weight: 700">← @Localizer["FC_BACK_TO_LOGIN"]</a>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
