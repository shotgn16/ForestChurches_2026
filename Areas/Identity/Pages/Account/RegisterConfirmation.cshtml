@page
@model RegisterConfirmationModel
@{
    ViewData["Title"] = Localizer["FC_CHECK_INBOX"];
}
<div class="fc-auth__form" style="flex: 1 0 auto; padding-top: 64px; padding-bottom: 64px">
    <div class="fc-auth__box fc-auth__box--card">
        <span class="fc-icon-tile fc-icon-tile--ok" aria-hidden="true"><svg class="fc-icon" style="width: 26px; height: 26px" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="M3 7l9 6 9-6"></path></svg></span>
        <h1 style="font-size: 30px">@Localizer["FC_CHECK_INBOX"]</h1>
        @if (Model.DisplayConfirmAccountLink)
        {
            <p class="fc-muted">@Localizer["FC_CONFIRM_LINK_DEV"]</p>
            <a id="confirm-link" href="@Model.EmailConfirmationUrl" class="fc-btn fc-btn--primary">@Localizer["FC_CONFIRM_ACCOUNT"]</a>
        }
        else
        {
            <p class="fc-muted">@Localizer["FC_CONFIRM_EMAIL_SENT"]</p>
        }
    </div>
</div>
