@page
@model ResetAuthenticatorModel
@{
    ViewData["Title"] = Localizer["BTN_RESET_AUTHENTICATOR_APP"];
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<div class="fc-page-head">
    <div>
        <a asp-page="./TwoFactorAuthentication" class="fc-small" style="font-weight: 700">← @Localizer["TITLE_TWO_FACTOR_AUTHENTICATION"]</a>
        <h1 style="margin-top: 6px">@Localizer["BTN_RESET_AUTHENTICATOR_APP"]</h1>
    </div>
</div>

<partial name="_StatusMessage" for="StatusMessage" />

<section class="fc-card fc-card--danger fc-stack" style="gap: 14px">
    <div class="fc-alert fc-alert--warn" role="alert">
        <strong>@Localizer["FC_RESET_AUTH_WARN"]</strong>
        <p style="margin-top: 6px">@Localizer["FC_RESET_AUTH_TEXT"]</p>
    </div>
    <form id="reset-authenticator-form" method="post" class="fc-btn-row">
        <a asp-page="./TwoFactorAuthentication" class="fc-btn fc-btn--quiet">@Localizer["FC_CANCEL"]</a>
        <button id="reset-authenticator-button" class="fc-btn fc-btn--danger" type="submit">@Localizer["BTN_RESET_AUTHENTICATOR_APP"]</button>
    </form>
</section>
