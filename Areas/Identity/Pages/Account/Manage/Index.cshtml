@page
@model IndexModel
@{
    ViewData["ActivePage"] = ManageNavPages.Index;
    ViewData["Title"] = Localizer["NAV_LABEL_PROFILE"];
}

<div class="fc-page-head">
    <div>
        <h1>@Localizer["NAV_LABEL_PROFILE"]</h1>
        <p>@Localizer["FC_PROFILE_LEAD"]</p>
    </div>
</div>

<partial name="_StatusMessage" for="statusMessage" />

<section class="fc-card" aria-labelledby="you-h">
    <h2 id="you-h" class="fc-card__title">@Localizer["FC_YOUR_DETAILS"]</h2>
    <form id="profile-form" method="post" class="fc-stack" style="max-width: 760px">
        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
        <div class="fc-grid">
            <div class="fc-field">
                <label class="fc-label" asp-for="Username">@Localizer["FC_EMAIL_SIGN_IN"]</label>
                <input class="fc-input" asp-for="Username" readonly aria-describedby="username-hint" />
                <span id="username-hint" class="fc-hint">@Localizer["FC_EMAIL_CHANGE_HINT"]</span>
            </div>
            <div class="fc-field">
                <label class="fc-label" asp-for="Input.PhoneNumber">@Localizer["TAG_PHONE"] <span class="fc-opt">— @Localizer["FC_OPTIONAL"]</span></label>
                <input class="fc-input" asp-for="Input.PhoneNumber" type="tel" autocomplete="tel" />
                <span asp-validation-for="Input.PhoneNumber" class="text-danger"></span>
            </div>
        </div>
        <div>
            <button id="update-profile-button" type="submit" class="fc-btn fc-btn--primary">@Localizer["TAG_SAVE"]</button>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
