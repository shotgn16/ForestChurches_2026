@page
@model ChangePasswordModel
@{
    ViewData["Title"] = Localizer["TAG_CHANGE_PASSWORD"];
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<div class="fc-page-head">
    <div>
        <h1>@Localizer["NAV_LABEL_PASSWORD"]</h1>
        <p>@Localizer["FC_SECURITY_LEAD"]</p>
    </div>
</div>

<partial name="_StatusMessage" for="StatusMessage" />

<section class="fc-card" aria-labelledby="pw-h">
    <h2 id="pw-h" class="fc-card__title">@Localizer["TAG_CHANGE_PASSWORD"]</h2>
    <form id="change-password-form" method="post" class="fc-stack" style="max-width: 520px">
        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
        <div class="fc-field">
            <label class="fc-label" asp-for="Input.OldPassword">@Localizer["TAG_CURRENT_PWD"]</label>
            <input class="fc-input" asp-for="Input.OldPassword" autocomplete="current-password" aria-required="true" />
            <span asp-validation-for="Input.OldPassword" class="text-danger"></span>
        </div>
        <div class="fc-field">
            <label class="fc-label" asp-for="Input.NewPassword">@Localizer["TAG_NEW_PWD"]</label>
            <input class="fc-input" asp-for="Input.NewPassword" autocomplete="new-password" aria-required="true" aria-describedby="pw-hint" />
            <span id="pw-hint" class="fc-hint">@Localizer["FC_PASSWORD_HINT"]</span>
            <span asp-validation-for="Input.NewPassword" class="text-danger"></span>
        </div>
        <div class="fc-field">
            <label class="fc-label" asp-for="Input.ConfirmPassword">@Localizer["FC_CONFIRM_NEW_PASSWORD"]</label>
            <input class="fc-input" asp-for="Input.ConfirmPassword" autocomplete="new-password" aria-required="true" />
            <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
        </div>
        <div>
            <button type="submit" class="fc-btn fc-btn--primary">@Localizer["FC_UPDATE_PASSWORD"]</button>
        </div>
    </form>
</section>

<section class="fc-card fc-row fc-row--between" aria-labelledby="tfa-link-h">
    <div class="fc-stack" style="gap: 4px; flex: 1 1 320px">
        <h2 id="tfa-link-h" class="fc-h3">@Localizer["TITLE_TWO_FACTOR_AUTHENTICATION"]</h2>
        <p class="fc-small fc-muted">@Localizer["FC_2FA_LEAD"]</p>
    </div>
    <a class="fc-btn fc-btn--outline" asp-page="./TwoFactorAuthentication">@Localizer["FC_MANAGE"]</a>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
