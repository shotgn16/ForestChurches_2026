@page
@model ChangePasswordModel
@inject ForestChurches.Components.Storage.IBlobUrlService BlobUrlService;
@{
    ViewData["Title"] = "Change password";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;

    var defaultSrc = BlobUrlService.GetReadSasUrl("IMGUR-1.png", TimeSpan.FromDays(7));
    string src = defaultSrc;

    if (Model?.Currentuser != null)
    {
        if (!string.IsNullOrEmpty(Model.Currentuser.ImageBlobName))
        {
            src = BlobUrlService.GetReadSasUrl(Model.Currentuser.ImageBlobName, TimeSpan.FromDays(7));
        }
        else if (Model.Currentuser.ImageArray != null && Model.Currentuser.ImageArray.Length > 1)
        {
            src = "data:image;base64," + System.Convert.ToBase64String(Model.Currentuser.ImageArray);
        }
    }
}
<head>
    <link rel="stylesheet" href="~/css2/profile.css" asp-append-version="true" />

    <style>
            /* Forces the label into the floating position at all times */
            .form-floating > .form-control ~ label {
                transform: scale(0.85) translateY(-0.5rem) translateX(0.15rem);
                opacity: 0.65;
            }

            /* Ensures the input text has proper padding underneath the static label */
            .form-floating > .form-control {
                padding-top: 1.625rem;
                padding-bottom: 0.625rem;
            }
    </style>
</head>

<!-- Beginning of Page header -->
<div class="container-fluid page-hero">
    <div class="hero-text">
        <div>
            <img src="@src" alt="profile picture" />
        </div>
        <div class="heading-text">
            <h1>@Localizer["PROFILE_WELCOME_BACK"]</h1>
            <p>@Model.CurrentChurch?.Name, <strong>@Model.CurrentChurch?.Status</strong></p>
        </div>
    </div>
</div>

<!-- Tab Nav -->
<partial name="_ManageNav" />
<partial name="_StatusMessage" for="StatusMessage" />

<!-- Beginning of COntent -->
<section>
    <h1>
        @Localizer["TAG_CHANGE_PASSWORD"]</h1><br>
    <form id="change-password-form" method="post">
        <!-- AntiforgeryToken -->
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
        
        <div class="form-floating mb-3">
            <input asp-for="Input.OldPassword" class="form-control" autocomplete="current-password" aria-required="true" placeholder="@Localizer["TAG_OLD_PASSWORD"]" />
            <label asp-for="Input.OldPassword" class="form-label">@Localizer["TAG_CURRENT_PWD"]</label>
            <span asp-validation-for="Input.OldPassword" class="text-danger"></span>
        </div>

        <div class="form-floating mb-3">
            <input asp-for="Input.NewPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="@Localizer["TAG_NEW_PASSWORD"]" />
            <label asp-for="Input.NewPassword" class="form-label">@Localizer["TAG_NEW_PWD"]</label>
            <span asp-validation-for="Input.NewPassword" class="text-danger"></span>
        </div>

        <div class="form-floating mb-3">
            <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="@Localizer["TAG_NEW_PASSWORD"]" />
            <label asp-for="Input.ConfirmPassword" class="form-label">@Localizer["TAG_NEW_PWD"]</label>
            <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
        </div>

        <button type="submit" class="w-100 btn btn-lg btn-success">@Localizer["STATUS_SAVE"]</button>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}