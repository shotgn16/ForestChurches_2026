@page
@model ShowRecoveryCodesModel
@{
    ViewData["Title"] = Localizer["FC_RECOVERY_CODES"];
    ViewData["ActivePage"] = "TwoFactorAuthentication";
}

<div class="fc-page-head">
    <div>
        <a asp-page="./TwoFactorAuthentication" class="fc-small" style="font-weight: 700">← @Localizer["TITLE_TWO_FACTOR_AUTHENTICATION"]</a>
        <h1 style="margin-top: 6px">@Localizer["FC_RECOVERY_CODES"]</h1>
    </div>
</div>

<partial name="_StatusMessage" for="StatusMessage" />

<section class="fc-card fc-stack" style="gap: 16px">
    <div class="fc-alert fc-alert--warn" role="alert">
        <strong>@Localizer["FC_CODES_SAFE_PLACE"]</strong>
        <p style="margin-top: 6px">@Localizer["FC_CODES_LOSE_DEVICE"]</p>
    </div>
    <ul class="fc-codes" aria-label="@Localizer["FC_RECOVERY_CODES"]">
        @foreach (var code in Model.RecoveryCodes ?? Array.Empty<string>())
        {
            <li>@code</li>
        }
    </ul>
    <div class="fc-btn-row fc-no-print">
        <button type="button" class="fc-btn fc-btn--outline" data-fc-print>@Localizer["FC_PRINT"]</button>
        <a asp-page="./TwoFactorAuthentication" class="fc-btn fc-btn--primary">@Localizer["FC_DONE"]</a>
    </div>
</section>
