@page
@using Microsoft.AspNetCore.Http.Features
@model TwoFactorAuthenticationModel
@inject ForestChurches.Components.Storage.IBlobUrlService BlobUrlService;
@{
    ViewData["Title"] = Localizer["TITLE_TWO_FACTOR_AUTHENTICATION"];
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;

    var defaultSrc = BlobUrlService.GetReadSasUrl("IMGUR-1.png", TimeSpan.FromDays(7));
    string src = defaultSrc;

    if (Model?.Currentuser != null)
    {
        if (!string.IsNullOrEmpty(Model.Currentuser.ImageBlobName))
        {
            src = BlobUrlService.GetReadSasUrl(Model.Currentuser.ImageBlobName, TimeSpan.FromDays(7));
        }
        else if (Model.Currentuser.ImageArray != null && Model.Currentuser.ImageArray.Length > 1)
        {
            src = "data:image;base64," + System.Convert.ToBase64String(Model.Currentuser.ImageArray);
        }
    }
}
<head>
    <link rel="stylesheet" href="~/css2/profile.css" asp-append-version="true" />
</head><!-- Beginning of Page header --><div class="container-fluid page-hero">
<div class="hero-text">
    <div>
        <img src="@src" alt="@Localizer["ALT_PROFILE_PICTURE"]" />
    </div>
    <div class="heading-text">
        <h1>@Localizer["PROFILE_WELCOME_BACK"]</h1>
        <p>@Model.CurrentChurch?.Name, <strong>@Model.CurrentChurch?.Status</strong></p>
    </div>
</div>
</div><!-- Tab Nav -->
<partial name="_ManageNav" />
<partial name="_StatusMessage" for="StatusMessage" />
@* Bulletin notify for TwoFactorAuthentication page *@
@await Html.PartialAsync("_BulletinNotify")
<section class="data-section">
    <h3>@Localizer["UpdateTitle"] @ViewData["Title"]]</h3>
    @{
        var consentFeature = HttpContext.Features.Get<ITrackingConsentFeature>();
        @if (consentFeature?.CanTrack ?? true)
        {
            @if (Model.Is2faEnabled)
            {
                if (Model.RecoveryCodesLeft == 0)
                {
                    <div class="alert alert-danger">
                        <strong>@Localizer["NO_RECOVERY_CODES_LEFT_TITLE"]</strong>
                        <p>@Localizer["MUST_GENERATE_CODES_BEFORE"] <a asp-page="./GenerateRecoveryCodes">@Localizer["GENERATE_NEW_CODES_LINK"]</a> @Localizer["MUST_GENERATE_CODES_AFTER"]</p>
                    </div>
                }
                else if (Model.RecoveryCodesLeft == 1)
                {
                    <div class="alert alert-danger">
                        <strong>@Localizer["ONE_RECOVERY_CODE_LEFT_TITLE"]</strong>
                        <p>@Localizer["CAN_GENERATE_CODES_BEFORE"] <a asp-page="./GenerateRecoveryCodes">@Localizer["GENERATE_NEW_CODES_LINK"]</a>.</p>
                    </div>
                }
                else if (Model.RecoveryCodesLeft <= 3)
                {
                    <div class="alert alert-warning">
                        <strong>@Localizer["MULTIPLE_RECOVERY_CODES_LEFT_BEFORE"] @Model.RecoveryCodesLeft @Localizer["MULTIPLE_RECOVERY_CODES_LEFT_AFTER"]</strong>
                        <p>@Localizer["SHOULD_GENERATE_CODES_BEFORE"] <a asp-page="./GenerateRecoveryCodes">@Localizer["GENERATE_NEW_CODES_LINK"]</a>.</p>
                    </div>
                }

                if (Model.IsMachineRemembered)
                {
                    <form method="post" style="display: inline-block">
                        <button type="submit" class="btn btn-success">@Localizer["BTN_FORGET_BROWSER"]</button>
                        <!-- AntiforgeryToken -->
                        @Html.AntiForgeryToken()
                    </form>
                }
                <a asp-page="./Disable2fa" class="btn btn-success">@Localizer["BTN_DISABLE_2FA"]</a>
                <a asp-page="./GenerateRecoveryCodes" class="btn btn-success">@Localizer["BTN_RESET_RECOVERY_CODES"]</a>
            }

            <h4>@Localizer["AUTHENTICATOR_APP_HEADER"]</h4>
            @if (!Model.HasAuthenticator)
            {
                <a id="enable-authenticator" asp-page="./EnableAuthenticator" class="btn btn-success">@Localizer["BTN_ADD_AUTHENTICATOR_APP"]</a>
            }
            else
            {
                <a id="enable-authenticator" asp-page="./EnableAuthenticator" class="btn btn-success">@Localizer["BTN_SET_UP_AUTHENTICATOR_APP"]</a>
                <a id="reset-authenticator" asp-page="./ResetAuthenticator" class="btn btn-success">@Localizer["BTN_RESET_AUTHENTICATOR_APP"]</a>
            }
        }
        else
        {
            <div class="alert alert-danger">
                <strong>@Localizer["PRIVACY_POLICY_NOT_ACCEPTED_TITLE"]</strong>
                <p>@Localizer["PRIVACY_POLICY_NOT_ACCEPTED_BODY"]</p>
            </div>
        }
    }
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}