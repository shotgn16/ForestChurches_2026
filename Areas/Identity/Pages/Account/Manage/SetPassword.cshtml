@page
@model SetPasswordModel
@{
    ViewData["Title"] = Localizer["FC_SET_PASSWORD"];
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<div class="fc-page-head">
    <div>
        <h1>@Localizer["FC_SET_PASSWORD"]</h1>
        <p>@Localizer["FC_SET_PASSWORD_LEAD"]</p>
    </div>
</div>

<partial name="_StatusMessage" for="StatusMessage" />

<section class="fc-card">
    <form id="set-password-form" method="post" class="fc-stack" style="max-width: 520px">
        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
        <div class="fc-field">
            <label class="fc-label" asp-for="Input.NewPassword">@Localizer["TAG_NEW_PWD"]</label>
            <input class="fc-input" asp-for="Input.NewPassword" autocomplete="new-password" aria-describedby="set-pw-hint" />
            <span id="set-pw-hint" class="fc-hint">@Localizer["FC_PASSWORD_HINT"]</span>
            <span asp-validation-for="Input.NewPassword" class="text-danger"></span>
        </div>
        <div class="fc-field">
            <label class="fc-label" asp-for="Input.ConfirmPassword">@Localizer["FC_CONFIRM_NEW_PASSWORD"]</label>
            <input class="fc-input" asp-for="Input.ConfirmPassword" autocomplete="new-password" />
            <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
        </div>
        <div><button type="submit" class="fc-btn fc-btn--primary">@Localizer["FC_SET_PASSWORD"]</button></div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
