@page
@model EnableAuthenticatorModel
@{
    ViewData["Title"] = Localizer["BTN_SET_UP_AUTHENTICATOR_APP"];
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<div class="fc-page-head">
    <div>
        <a asp-page="./TwoFactorAuthentication" class="fc-small" style="font-weight: 700">← @Localizer["TITLE_TWO_FACTOR_AUTHENTICATION"]</a>
        <h1 style="margin-top: 6px">@Localizer["BTN_SET_UP_AUTHENTICATOR_APP"]</h1>
    </div>
</div>

<partial name="_StatusMessage" for="StatusMessage" />

<section class="fc-card">
    <ol class="fc-stack fc-stack--lg" style="list-style: none; margin: 0; padding: 0">
        <li class="fc-row" style="align-items: flex-start; flex-wrap: nowrap; gap: 14px">
            <span class="fc-date" style="flex-basis: 36px; height: 36px; border-radius: 50%" aria-hidden="true"><span class="fc-date__day" style="font-size: 18px">1</span></span>
            <div class="fc-stack" style="gap: 4px">
                <strong>@Localizer["FC_2FA_STEP1"]</strong>
                <span class="fc-small fc-muted">@Localizer["FC_2FA_STEP1_TEXT"]</span>
            </div>
        </li>
        <li class="fc-row" style="align-items: flex-start; flex-wrap: nowrap; gap: 14px">
            <span class="fc-date" style="flex-basis: 36px; height: 36px; border-radius: 50%" aria-hidden="true"><span class="fc-date__day" style="font-size: 18px">2</span></span>
            <div class="fc-stack" style="gap: 10px">
                <strong>@Localizer["FC_2FA_STEP2"]</strong>
                <div id="qrCode" class="fc-qr" data-fc-qr="@Model.AuthenticatorUri" role="img" aria-label="@Localizer["FC_2FA_QR_ALT"]"></div>
                <span class="fc-small fc-muted">@Localizer["FC_2FA_KEY_TEXT"] <code>@Model.SharedKey</code></span>
            </div>
        </li>
        <li class="fc-row" style="align-items: flex-start; flex-wrap: nowrap; gap: 14px">
            <span class="fc-date" style="flex-basis: 36px; height: 36px; border-radius: 50%" aria-hidden="true"><span class="fc-date__day" style="font-size: 18px">3</span></span>
            <form id="send-code" method="post" class="fc-stack" style="gap: 10px; flex: 1 1 auto; max-width: 420px">
                <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                <div class="fc-field">
                    <label class="fc-label" asp-for="Input.Code">@Localizer["FC_2FA_STEP3"]</label>
                    <input class="fc-input" asp-for="Input.Code" autocomplete="one-time-code" inputmode="numeric" />
                    <span asp-validation-for="Input.Code" class="text-danger"></span>
                </div>
                <div><button type="submit" class="fc-btn fc-btn--primary">@Localizer["FC_VERIFY_TURN_ON"]</button></div>
            </form>
        </li>
    </ol>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
}
