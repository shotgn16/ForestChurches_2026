@page
@model EmailModel
@{
    ViewData["Title"] = Localizer["FC_EMAIL_SIGN_IN"];
    ViewData["ActivePage"] = ManageNavPages.Index;
}

<div class="fc-page-head">
    <div>
        <h1>@Localizer["FC_EMAIL_SIGN_IN"]</h1>
    </div>
</div>

<partial name="_StatusMessage" for="StatusMessage" />

<section class="fc-card">
    <form id="email-form" method="post" class="fc-stack" style="max-width: 560px">
        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
        <div class="fc-field">
            <label class="fc-label" asp-for="Email">@Localizer["FC_CURRENT_EMAIL"]</label>
            <input class="fc-input" asp-for="Email" readonly />
            @if (Model.IsEmailConfirmed)
            {
                <span class="fc-badge fc-badge--ok" style="align-self: flex-start">✓ @Localizer["FC_CONFIRMED"]</span>
            }
            else
            {
                <button id="email-verification" type="submit" asp-page-handler="SendVerificationEmail" class="fc-link-btn" style="align-self: flex-start">@Localizer["FC_SEND_VERIFICATION"]</button>
            }
        </div>
        <div class="fc-field">
            <label class="fc-label" asp-for="Input.NewEmail">@Localizer["FC_NEW_EMAIL"]</label>
            <input class="fc-input" asp-for="Input.NewEmail" autocomplete="email" aria-required="true" />
            <span asp-validation-for="Input.NewEmail" class="text-danger"></span>
        </div>
        <div><button id="change-email-button" type="submit" asp-page-handler="ChangeEmail" class="fc-btn fc-btn--primary">@Localizer["FC_SAVE_CHANGES"]</button></div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
