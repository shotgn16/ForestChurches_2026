@page
@model GenerateRecoveryCodesModel
@{
    ViewData["Title"] = Localizer["FC_NEW_RECOVERY_CODES"];
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<div class="fc-page-head">
    <div>
        <a asp-page="./TwoFactorAuthentication" class="fc-small" style="font-weight: 700">← @Localizer["TITLE_TWO_FACTOR_AUTHENTICATION"]</a>
        <h1 style="margin-top: 6px">@Localizer["FC_NEW_RECOVERY_CODES"]</h1>
    </div>
</div>

<partial name="_StatusMessage" for="StatusMessage" />

<section class="fc-card fc-stack" style="gap: 14px">
    <div class="fc-alert fc-alert--warn" role="alert">
        <strong>@Localizer["FC_CODES_SAFE_PLACE"]</strong>
        <p style="margin-top: 6px">@Localizer["FC_CODES_LOSE_DEVICE"]</p>
        <p style="margin-top: 6px">@Localizer["FC_CODES_KEYS_UNCHANGED"] <a asp-page="./ResetAuthenticator">@Localizer["BTN_RESET_AUTHENTICATOR_APP"]</a>.</p>
    </div>
    <form method="post" class="fc-btn-row" data-fc-confirm="@Localizer["FC_CONFIRM_NEW_CODES"]">
        <button class="fc-btn fc-btn--primary" type="submit">@Localizer["FC_NEW_RECOVERY_CODES"]</button>
    </form>
</section>
