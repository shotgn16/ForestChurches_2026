@using ForestChurches.Components.Users
@using Microsoft.EntityFrameworkCore
@inject UserManager<ChurchAccount> UserManager
@inject ForestChurches.Data.ForestChurchesContext DbContext
@inject ForestChurches.Components.Storage.IBlobUrlService BlobUrlService
@inject ForestChurches.Components.Security.Encoder Encoder
@inject ForestChurches.Components.Users.IManagedChurches ManagedChurches
@{
    if (ViewData.TryGetValue("ParentLayout", out var parentLayout) && parentLayout != null)
    {
        Layout = parentLayout.ToString();
    }
    else
    {
        Layout = "/Pages/Shared/_Layout.cshtml";
    }
    ViewData["FcShell"] = "admin";

    // Church summary for the sidebar header. Never let it break the page.
    // An account can manage several churches (a benefice); the switcher picks which one the pages act on.
    ForestChurches.Models.ChurchInformation? church = null;
    var allChurches = new List<ForestChurches.Models.ChurchInformation>();
    string? logoBlob = null;
    try
    {
        var userId = UserManager.GetUserId(User);
        if (!string.IsNullOrEmpty(userId))
        {
            church = await ManagedChurches.CurrentAsync(Context, userId);
            allChurches = await ManagedChurches.ListAsync(userId);
            logoBlob = !string.IsNullOrEmpty(church?.ImageBlobName)
                ? church!.ImageBlobName
                : (await UserManager.FindByIdAsync(userId))?.ImageBlobName;
        }
    }
    catch
    {
        church = null;
    }
    var logoSrc = BlobUrlService.GetReadSasUrl(string.IsNullOrEmpty(logoBlob) ? "IMGUR-1.png" : logoBlob, TimeSpan.FromHours(1));
    var isOpen = string.Equals(church?.Status, "Open", StringComparison.OrdinalIgnoreCase);
}

@section AdminBarLinks {
    @if (church != null && isOpen)
    {
        <a asp-area="" asp-page="/Church" asp-route-id="@Encoder.Protect(church.ID, "fc.data.church.information")">@Localizer["FC_VIEW_PUBLIC_PAGE"] ↗</a>
    }
    <a asp-area="" asp-page="/Index">@Localizer["FC_BACK_TO_SITE"]</a>
}

<div class="fc-container fc-admin">
    <nav class="fc-admin__side" aria-label="@Localizer["FC_ACCOUNT_NAV"]">
        @if (church != null)
        {
            <div class="fc-admin__church">
                <img src="@logoSrc" alt="" width="48" height="48" />
                <div>
                    <strong>@ForestChurches.Components.Ui.FcText.PlainText(church.Name)</strong>
                    <span class="fc-admin__status @(isOpen ? "" : "fc-admin__status--closed")">● @(isOpen ? Localizer["FC_STATUS_OPEN_LISTED"] : Localizer["FC_STATUS_CLOSED_HIDDEN"])</span>
                </div>
            </div>
            @if (allChurches.Count > 1)
            {
                <form method="get" class="fc-church-switch" action="@Context.Request.Path">
                    <label class="fc-label" for="fc-church-switch">@Localizer["FC_CHURCH_SWITCH_LABEL"]</label>
                    <div class="fc-row" style="gap: 8px; flex-wrap: nowrap">
                        <select class="fc-select" id="fc-church-switch" name="church" data-fc-autosubmit>
                            @foreach (var c in allChurches)
                            {
                                <option value="@ManagedChurches.Protect(c.ID)" selected="@(c.ID == church.ID)">@ForestChurches.Components.Ui.FcText.PlainText(c.Name)@(string.Equals(c.Status, "Open", StringComparison.OrdinalIgnoreCase) ? "" : " (" + Localizer["FC_STATUS_CLOSED_SHORT"].Value + ")")</option>
                            }
                        </select>
                        <button type="submit" class="fc-btn fc-btn--outline fc-btn--sm">@Localizer["FC_CHURCH_SWITCH_BUTTON"]</button>
                    </div>
                </form>
            }
        }
        <partial name="/Areas/Identity/Pages/Account/Manage/_ManageNav.cshtml" />
    </nav>

    <div class="fc-admin__main">
        @RenderBody()
    </div>
</div>

@section Scripts {
    @RenderSection("Scripts", required: false)
}
@* Some older account pages declare an empty Styles section; accept it rather than throwing. *@
@if (IsSectionDefined("Styles")) { IgnoreSection("Styles"); }
