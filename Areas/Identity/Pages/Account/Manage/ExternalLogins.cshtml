@page
@model ExternalLoginsModel
@inject ForestChurches.Components.Security.Encoder Encoder;
@{
    ViewData["Title"] = Localizer["FC_NAV_CHURCHSUITE"];
    ViewData["ActivePage"] = ManageNavPages.ExternalLogins;
    var connected = Model?.HasChurchSuiteCredentials == true;
    var authError = TempData["ChurchSuiteAuthError"] as string;
}

<div class="fc-page-head">
    <div>
        <h1>@Localizer["FC_NAV_CHURCHSUITE"]</h1>
        <p>@Localizer["FC_CHURCHSUITE_LEAD"]</p>
    </div>
</div>

<partial name="_StatusMessage" for="StatusMessage" />
@if (!string.IsNullOrEmpty(authError))
{
    <div class="fc-alert fc-alert--warn" role="alert">@authError</div>
}

<section class="fc-card fc-stack" aria-labelledby="cs-h" style="gap: 20px">
    <div class="fc-row" style="gap: 16px">
        <span class="fc-cs-mark" aria-hidden="true"><svg class="fc-icon" style="width: 28px; height: 28px" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"></circle><path d="M12 3v18M3 12h18"></path></svg></span>
        <div class="fc-stack" style="gap: 4px; flex: 1 1 300px">
            <h2 id="cs-h" class="fc-h3">@Localizer["TAG_CONNECT_CHURCHSUITE"]</h2>
            @if (connected)
            {
                <span class="fc-badge fc-badge--ok" style="align-self: flex-start">● @(Model!.ChurchSuiteStatusMessage ?? Localizer["FC_CONNECTED"].Value)</span>
            }
            else
            {
                <span class="fc-small fc-muted">@(Model?.ChurchSuiteStatusMessage ?? Localizer["FC_NOT_CONNECTED"].Value)</span>
            }
        </div>
        @if (connected)
        {
            <form method="post" asp-page="./ChurchProfile" asp-page-handler="SyncChurchSuiteOAuth">
                <button type="submit" class="fc-btn fc-btn--primary">@Localizer["FC_SYNC_NOW"]</button>
            </form>
        }
    </div>

    @if (!connected)
    {
        <ol class="fc-stack" style="margin: 0; padding-left: 22px; gap: 8px; color: var(--fc-ink-2)">
            <li>@Localizer["FC_CS_STEP_1"]</li>
            <li>@Localizer["FC_CS_STEP_2"]</li>
            <li>@Localizer["FC_CS_STEP_3"]</li>
        </ol>
    }

    <form method="post" asp-page-handler="SetClientId" class="fc-search__row">
        <div class="fc-field fc-field--wide" style="flex: 1 1 320px">
            <label class="fc-label" for="cs-client-id">@Localizer["TAG_CHURCHSUITE_CLIENT_ID"]</label>
            <input class="fc-input" id="cs-client-id" name="clientId" value="@(Model?.Currentuser?.ClientId ?? string.Empty)" autocomplete="off" spellcheck="false" />
            <span class="fc-hint">@Localizer["TAG_CHURCHSUITE_DESC"]</span>
        </div>
        <button type="submit" class="fc-btn @(connected ? "fc-btn--outline" : "fc-btn--primary")">@Localizer["TAG_SAVE_AUTHORIZE"]</button>
    </form>
</section>

@if (Model?.CurrentLogins?.Count > 0 || Model?.OtherLogins?.Count > 0)
{
    <section class="fc-card" aria-labelledby="ext-h">
        <h2 id="ext-h" class="fc-card__title">@Localizer["TAG_REGISTERED_LOGINS"]</h2>
        @if (Model.CurrentLogins?.Count > 0)
        {
            @foreach (var login in Model.CurrentLogins)
            {
                <div class="fc-list-row">
                    <span id="@($"login-provider-{login.LoginProvider}")" style="font-weight: 700">@login.ProviderDisplayName</span>
                    @if (Model.ShowRemoveButton)
                    {
                        <form id="@($"remove-login-{login.LoginProvider}")" asp-page-handler="RemoveLogin" method="post" data-fc-confirm="@Localizer["FC_CONFIRM_REMOVE_LOGIN", login.ProviderDisplayName ?? login.LoginProvider]">
                            <input asp-for="@login.LoginProvider" name="LoginProvider" type="hidden" />
                            <input asp-for="@login.ProviderKey" name="ProviderKey" type="hidden" />
                            <button type="submit" class="fc-btn fc-btn--danger-outline fc-btn--sm">@Localizer["STATUS_REMOVE"]<span class="fc-sr-only"> @login.ProviderDisplayName</span></button>
                        </form>
                    }
                </div>
            }
        }
        @if (Model.OtherLogins?.Count > 0)
        {
            <h3 class="fc-h3" style="font-size: 18px !important; margin: 16px 0 10px">@Localizer["TAG_ANOTHER_SERVICE"]</h3>
            <form id="link-login-form" asp-page-handler="LinkLogin" method="post" class="fc-btn-row">
                @foreach (var provider in Model.OtherLogins)
                {
                    <button id="@($"link-login-button-{provider.Name}")" type="submit" class="fc-btn fc-btn--outline" name="provider" value="@Encoder.Protect(provider.Name, "fc.data.login.external")">@provider.DisplayName</button>
                }
            </form>
        }
    </section>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
