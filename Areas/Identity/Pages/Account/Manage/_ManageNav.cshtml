@using ForestChurches.Components.Users
@using Microsoft.Extensions.Localization
@inject SignInManager<ChurchAccount> SignInManager
@{
    var hasExternalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).Any();
}

<head>
    <link rel="stylesheet" href="~/css2/Nav.css" asp-append-version="true" />
</head>

<nav class="nav nav-pills nav-fill">
    <a class="nav-item nav-link @ManageNavPages.IndexNavClass(ViewContext) id="profile" asp-page="./Index">@Localizer["NAV_LABEL_PROFILE"]</a>
    <a class="nav-item nav-link @ManageNavPages.ChurchProfileNavClass(ViewContext)" id="churchProfile" asp-page="./ChurchProfile">@Localizer["NAV_LABEL_CHURCH_PROFILE"]</a>
    <a class="nav-item nav-link @ManageNavPages.BulletinNavClass(ViewContext)" id="bulletin" asp-page="/Admin/Bulletin/Index">Bulletins</a>
    @* <a class="nav-item nav-link @ManageNavPages.EmailNavClass(ViewContext)" id="email" asp-page="./Email">Email</a> *@
    <a class="nav-item nav-link @ManageNavPages.ChangePasswordNavClass(ViewContext)" id="change-password" asp-page="./ChangePassword">@Localizer["NAV_LABEL_PASSWORD"]</a>
    <a class="nav-item nav-link @ManageNavPages.ExternalLoginsNavClass(ViewContext)" id="external-login" asp-page="./ExternalLogins">@Localizer["NAV_LABEL_EXTERNAL_LOGIN"]</a>
    <a class="nav-item nav-link @ManageNavPages.TwoFactorAuthenticationNavClass(ViewContext)" id="two-factor" asp-page="./TwoFactorAuthentication">@Localizer["NAV_LABEL_2FA"]</a>
    <a class="nav-item nav-link @ManageNavPages.PersonalDataNavClass(ViewContext)" id="personal-data" asp-page="./PersonalData">@Localizer["NAV_LABEL_PERSONAL_DATA"]</a>
</nav>