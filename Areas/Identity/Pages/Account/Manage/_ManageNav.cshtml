@using ForestChurches.Components.Users
@{
    var active = ViewData["ActivePage"] as string;
    string? Current(string page) => string.Equals(active, page, StringComparison.OrdinalIgnoreCase) ? "page" : null;
    string Cls(string page) => string.Equals(active, page, StringComparison.OrdinalIgnoreCase) ? "active" : "";
    var isSiteAdmin = User.IsInRole(ForestChurches.Components.Roles.Roles.Admin.ToString()) || User.IsInRole(ForestChurches.Components.Roles.Roles.SuperAdmin.ToString());
}

<ul class="fc-sidenav">
    <li><a id="churchProfile" class="@Cls(ManageNavPages.ChurchProfile)" aria-current="@Current(ManageNavPages.ChurchProfile)" asp-area="Identity" asp-page="/Account/Manage/ChurchProfile">@Localizer["NAV_LABEL_CHURCH_PROFILE"]</a></li>
    <li><a id="events" class="@Cls("Events")" aria-current="@Current("Events")" asp-area="" asp-page="/Events/Index">@Localizer["NAV_MY_EVENTS"]</a></li>
    <li><a id="external-login" class="@Cls(ManageNavPages.ExternalLogins)" aria-current="@Current(ManageNavPages.ExternalLogins)" asp-area="Identity" asp-page="/Account/Manage/ExternalLogins">@Localizer["FC_NAV_CHURCHSUITE"]</a></li>
    <li><a id="bulletin" class="@Cls(ManageNavPages.Bulletin)" aria-current="@Current(ManageNavPages.Bulletin)" asp-area="Admin" asp-page="/Bulletin/Index">@Localizer["FC_NAV_BULLETINS"]</a></li>
    <li class="fc-sidenav__sep" role="presentation"></li>
    <li><a id="profile" class="@Cls(ManageNavPages.Index)" aria-current="@Current(ManageNavPages.Index)" asp-area="Identity" asp-page="/Account/Manage/Index">@Localizer["NAV_LABEL_PROFILE"]</a></li>
    <li><a id="change-password" class="@Cls(ManageNavPages.ChangePassword)" aria-current="@Current(ManageNavPages.ChangePassword)" asp-area="Identity" asp-page="/Account/Manage/ChangePassword">@Localizer["NAV_LABEL_PASSWORD"]</a></li>
    <li><a id="two-factor" class="@Cls(ManageNavPages.TwoFactorAuthentication)" aria-current="@Current(ManageNavPages.TwoFactorAuthentication)" asp-area="Identity" asp-page="/Account/Manage/TwoFactorAuthentication">@Localizer["NAV_LABEL_2FA"]</a></li>
    <li><a id="personal-data" class="@Cls(ManageNavPages.PersonalData)" aria-current="@Current(ManageNavPages.PersonalData)" asp-area="Identity" asp-page="/Account/Manage/PersonalData">@Localizer["NAV_LABEL_PERSONAL_DATA"]</a></li>
    <li class="fc-sidenav__sep" role="presentation"></li>
    <li><a id="help" asp-area="" asp-page="/Docs/Churches/Index">@Localizer["FC_NAV_HELP"]</a></li>
    @if (isSiteAdmin)
    {
        <li class="fc-sidenav__sep" role="presentation"></li>
        <li class="fc-sidenav__accent"><a asp-area="" asp-page="/Admin/Index">@Localizer["FC_NAV_SITE_ADMIN"] →</a></li>
    }
</ul>
