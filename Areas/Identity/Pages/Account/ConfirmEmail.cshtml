@page
@model ConfirmEmailModel
@inject ForestChurches.Components.Security.Encoder Encoder;
@{
    ViewData["Title"] = "Confirm email";
}
<head>
    <link rel="stylesheet" href="~/css2/profile.css" asp-append-version="true" />
    <link rel="stylesheet" integrity="sha256-EpEWU9eO/22A4h2K+m4PqmuwZfX72coUGoOLZLyncBA=" href="~/css2/Footer.css" asp-append-version="true" />
</head>
<style nonce="@HttpContextAccessor.HttpContext?.Items["CSP-Style-Nonce"]">
    .h1, h1 {
        text-align: center;
    }

    section {
        padding-top: calc(10.0rem + 1.0vw);
        text-align: center;
        top: 50%;
        bottom: 50%;
        inline-size: fit-content;
        vertical-align: central;
    }
</style>

<section>
    @{ 
        var _status = Model?.StatusMessage ?? string.Empty;
        if (_status.Contains("Error")) {
            <img alt="Forest Churches" src="~/img/cross.png" />
        }
        else {
            <img alt="Forest Churches" src="~/img/check.png" />
        }
    }
    <h1>@Encoder.HtmlEncode(ViewData["Title"].ToString())</h1>
    <p>Your email has been successfully confirmed!</p>
</section>