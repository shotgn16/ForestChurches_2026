@page
@model ConfirmEmailModel
@{
    var failed = (Model?.StatusMessage ?? string.Empty).Contains("Error", StringComparison.OrdinalIgnoreCase);
    ViewData["Title"] = failed ? Localizer["FC_CONFIRM_FAILED"] : Localizer["FC_EMAIL_CONFIRMED"];
}
<div class="fc-auth__form" style="flex: 1 0 auto; padding-top: 64px; padding-bottom: 64px">
    <div class="fc-auth__box fc-auth__box--card">
        <span class="fc-icon-tile @(failed ? "" : "fc-icon-tile--ok")" aria-hidden="true"><svg class="fc-icon" style="width: 26px; height: 26px" viewBox="0 0 24 24"><path d="@(failed ? "M6 6l12 12M18 6L6 18" : "M5 12l5 5 9-10")"></path></svg></span>
        <h1 style="font-size: 30px">@(failed ? Localizer["FC_CONFIRM_FAILED"] : Localizer["FC_EMAIL_CONFIRMED"])</h1>
        <p class="fc-muted">@(failed ? Localizer["FC_CONFIRM_FAILED_TEXT"] : Localizer["FC_EMAIL_CONFIRMED_TEXT"])</p>
        <a asp-page="./Login" class="fc-btn fc-btn--primary">@Localizer["FC_SIGN_IN"]</a>
    </div>
</div>
