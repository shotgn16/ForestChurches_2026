@page
@model ForgotPasswordConfirmation
@{
    ViewData["Title"] = Localizer["FC_CHECK_INBOX"];
}

<div class="fc-auth__form" style="flex: 1 0 auto; padding-top: 64px; padding-bottom: 64px">
    <div class="fc-auth__box fc-auth__box--card" role="status">
        <span class="fc-icon-tile fc-icon-tile--ok" aria-hidden="true"><svg class="fc-icon" style="width: 28px; height: 28px" viewBox="0 0 24 24"><path d="M5 12l5 5 9-10"></path></svg></span>
        <h1 style="font-size: 32px">@Localizer["FC_CHECK_INBOX"]</h1>
        <p class="fc-lead" style="font-size: 17px">@Localizer["FC_CHECK_INBOX_TEXT"]</p>
        <div class="fc-btn-row">
            <a asp-page="./Login" class="fc-btn fc-btn--primary">@Localizer["FC_BACK_TO_LOGIN"]</a>
            <a asp-page="./ForgotPassword" class="fc-btn fc-btn--quiet">@Localizer["FC_USE_DIFFERENT_EMAIL"]</a>
        </div>
    </div>
</div>
