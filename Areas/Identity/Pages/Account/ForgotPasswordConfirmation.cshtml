@page
@model ForgotPasswordConfirmation
@{
}
<head>
    <title>Confirmation</title>
    <link rel="stylesheet" href="~/css2/profile.css" asp-append-version="true" />
    <link rel="stylesheet" integrity="sha256-EpEWU9eO/22A4h2K+m4PqmuwZfX72coUGoOLZLyncBA=" href="~/css2/Footer.css" asp-append-version="true" />
</head>
<style nonce="@HttpContextAccessor.HttpContext?.Items["CSP-Style-Nonce"]">
    .h1, h1 {
        text-align: center;
    }

    section {
        padding-top: calc(11.0rem + 1vw);
        text-align: center;
        top: 50%;
        bottom: 50%;
        inline-size: fit-content;
        vertical-align: central;
    }
</style>

<section>
    <img alt="Forest Churches Logo" src="~/img/check.png" />
    <h1>Success!</h1>
    <p>If an account with that emails exist, a password reset email will be delivered to the given email address shortly</p>
