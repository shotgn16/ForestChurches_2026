@page
@model LoginWithRecoveryCodeModel
@{
    ViewData["Title"] = Localizer["FC_RECOVERY_CODE_LOGIN"];
}
<div class="fc-auth__form" style="flex: 1 0 auto; padding-top: 64px; padding-bottom: 64px">
    <div class="fc-auth__box fc-auth__box--card">
        <span class="fc-icon-tile" aria-hidden="true"><svg class="fc-icon" style="width: 26px; height: 26px" viewBox="0 0 24 24"><circle cx="8" cy="15" r="4"></circle><path d="M11 12l9-9M17 6l3 3"></path></svg></span>
        <h1 style="font-size: 30px">@Localizer["FC_RECOVERY_CODE_LOGIN"]</h1>
        <p class="fc-muted">@Localizer["FC_RECOVERY_CODE_LOGIN_TEXT"]</p>
        <form method="post" class="fc-stack">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <div class="fc-field">
                <label class="fc-label" asp-for="Input.RecoveryCode">@Localizer["FC_RECOVERY_CODE"]</label>
                <input class="fc-input" asp-for="Input.RecoveryCode" autocomplete="off" spellcheck="false" autofocus />
                <span asp-validation-for="Input.RecoveryCode" class="text-danger"></span>
            </div>
            <button type="submit" class="fc-btn fc-btn--primary fc-btn--lg fc-btn--block">@Localizer["FC_SIGN_IN"]</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
