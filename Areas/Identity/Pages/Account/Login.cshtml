@page
@model LoginModel
@using Microsoft.Extensions.Localization
@{
    ViewData["Title"] = Localizer["FC_NAV_CHURCH_LOGIN"];
    var error = TempData["ErrorMessage"] as string ?? ViewData["ErrorMessage"] as string ?? Model.ErrorMessage ?? Request.Query["error"].FirstOrDefault();
}

<div class="fc-auth">
    <div class="fc-auth__photo" aria-hidden="true">
        <img src="~/img/hero.jpg" alt="" />
        <div class="fc-auth__photo-shade"></div>
        <div class="fc-auth__photo-copy">
            <h2>@Localizer["FC_LOGIN_PITCH_TITLE"]</h2>
            <p>@Localizer["FC_LOGIN_PITCH_TEXT"]</p>
        </div>
    </div>

    <div class="fc-auth__form">
        <div class="fc-auth__box">
            <div class="fc-stack" style="gap: 6px">
                <h1 style="font-size: 36px">@Localizer["FC_NAV_CHURCH_LOGIN"]</h1>
                <p class="fc-muted">@Localizer["FC_LOGIN_LEAD"]</p>
            </div>

            @if (!string.IsNullOrEmpty(error))
            {
                <div class="fc-alert fc-alert--warn" role="alert">@error</div>
            }

            <form id="account" method="post" class="fc-stack">
                <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                <div class="fc-field">
                    <label class="fc-label" asp-for="Input.Email">@Localizer["LOGIN_EMAIL_LABEL"]</label>
                    <input class="fc-input" asp-for="Input.Email" type="email" autocomplete="username" aria-required="true" required autofocus />
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>
                <div class="fc-field">
                    <div class="fc-row fc-row--between" style="align-items: baseline">
                        <label class="fc-label" asp-for="Input.Password">@Localizer["LOGIN_PASSWORD_LABEL"]</label>
                        <a id="forgot-password" asp-page="./ForgotPassword" class="fc-tiny" style="font-weight: 700">@Localizer["LOGIN_FORGOT_PASSWORD_LINK"]</a>
                    </div>
                    <div class="fc-pw">
                        <input class="fc-input" asp-for="Input.Password" type="password" autocomplete="current-password" aria-required="true" required />
                        <button type="button" class="fc-pw__toggle" data-fc-pw-toggle aria-controls="Input_Password" aria-pressed="false" data-show="@Localizer["FC_SHOW"]" data-hide="@Localizer["FC_HIDE"]">@Localizer["FC_SHOW"]</button>
                    </div>
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>
                <label class="fc-check">
                    <input asp-for="Input.RememberMe" />
                    @Localizer["FC_KEEP_ME_SIGNED_IN"]
                </label>
                <button id="login-submit" type="submit" class="fc-btn fc-btn--primary fc-btn--lg fc-btn--block">@Localizer["FC_SIGN_IN"]</button>
            </form>

            @if (Model.ExternalLogins?.Count > 0)
            {
                <div class="fc-or">@Localizer["FC_OR"]</div>
                <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="fc-stack" style="gap: 10px">
                    @foreach (var provider in Model.ExternalLogins)
                    {
                        <button type="submit" class="fc-btn fc-btn--outline fc-btn--lg fc-btn--block" name="provider" value="@provider.Name">@Localizer["FC_SIGN_IN_WITH", provider.DisplayName ?? provider.Name]</button>
                    }
                </form>
            }

            <p class="fc-small fc-muted" style="line-height: 1.5">
                @Localizer["FC_NOT_SET_UP"] <a asp-area="" asp-page="/Contact" style="font-weight: 700">@Localizer["FC_ASK_FOR_INVITE"]</a>.
                <a id="resend-confirmation" asp-page="./ResendEmailConfirmation" style="font-weight: 700">@Localizer["LOGIN_RESEND_CONFIRMATION_LINK"]</a>
            </p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
