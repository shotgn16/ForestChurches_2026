@page
@model ExternalLoginModel
@{
    ViewData["Title"] = Localizer["RegisterTitle"];
}

<div class="fc-auth__form" style="flex: 1 0 auto; padding-top: 64px; padding-bottom: 64px">
    <div class="fc-auth__box fc-auth__box--card">
        <div class="fc-stack" style="gap: 6px">
            <h1 style="font-size: 30px">@Localizer["RegisterWith"] @Model.ProviderDisplayName</h1>
            <p class="fc-muted">@Localizer["FC_EXTERNAL_LEAD", Model.ProviderDisplayName ?? "ChurchSuite"]</p>
        </div>
        <form asp-page-handler="Confirmation" asp-route-returnUrl="@Model.ReturnUrl" asp-route-token="@Model.Token" method="post" class="fc-stack">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <div class="fc-field">
                <label class="fc-label" asp-for="Input.Email">@Localizer["LOGIN_EMAIL_LABEL"]</label>
                <input class="fc-input" asp-for="Input.Email" type="email" autocomplete="email" required autofocus />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>
            <div class="fc-field">
                <label class="fc-label" asp-for="Input.Password">@Localizer["LOGIN_PASSWORD_LABEL"]</label>
                <input class="fc-input" asp-for="Input.Password" type="password" autocomplete="new-password" required aria-describedby="ext-pw-hint" />
                <span id="ext-pw-hint" class="fc-hint">@Localizer["FC_PASSWORD_RULES"]</span>
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>
            <div class="fc-field">
                <label class="fc-label" asp-for="Input.ConfirmPassword">@Localizer["FC_CONFIRM_PASSWORD"]</label>
                <input class="fc-input" asp-for="Input.ConfirmPassword" type="password" autocomplete="new-password" required />
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
            </div>
            <button id="external-register" type="submit" class="fc-btn fc-btn--primary fc-btn--lg fc-btn--block">@Localizer["FC_CREATE_ACCOUNT"]</button>
        </form>
        <div class="fc-or">@Localizer["FC_OR"]</div>
        <a id="link-churchsuite" class="fc-btn fc-btn--outline fc-btn--block" href="/churchsuite/login-pkce?redirect_uri=@Uri.EscapeDataString(Model.ReturnUrl ?? "/")">@Localizer["FC_SIGN_IN_WITH", "ChurchSuite"]</a>
        <a asp-page="./Login" class="fc-small" style="font-weight: 700">← @Localizer["FC_BACK_TO_LOGIN"]</a>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
