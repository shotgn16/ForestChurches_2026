@page
@model RegisterModel
@{
    ViewData["Title"] = Localizer["FC_CREATE_ACCOUNT"];
    var error = TempData["ErrorMessage"] as string ?? ViewData["ErrorMessage"] as string ?? Request.Query["error"].FirstOrDefault();
}

<div class="fc-auth__form" style="flex: 1 0 auto; padding-top: 64px; padding-bottom: 64px">
    <div class="fc-auth__box fc-auth__box--card">
        <span class="fc-icon-tile" aria-hidden="true"><svg class="fc-icon" style="width: 26px; height: 26px" viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"></circle><path d="M4 21a8 8 0 0 1 16 0"></path></svg></span>
        <div class="fc-stack" style="gap: 6px">
            <h1 style="font-size: 30px">@Localizer["FC_CREATE_ACCOUNT"]</h1>
            <p class="fc-muted">@Localizer["FC_CREATE_ACCOUNT_LEAD"]</p>
        </div>

        @if (!string.IsNullOrEmpty(error))
        {
            <div class="fc-alert fc-alert--warn" role="alert">@error</div>
        }
        <partial name="_StatusMessage" model="Model.StatusMessage" />

        @if (Model.isTokenValid)
        {
            <form id="register-form" method="post" enctype="multipart/form-data" asp-route-returnUrl="@(Model.ReturnUrl ?? "/")" class="fc-stack">
                <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                <div class="fc-field">
                    <label class="fc-label" asp-for="Input.Email">@Localizer["LOGIN_EMAIL_LABEL"]</label>
                    <input class="fc-input" asp-for="Input.Email" type="email" autocomplete="username" required readonly aria-describedby="email-hint" />
                    <span id="email-hint" class="fc-hint">@Localizer["FC_INVITE_EMAIL_HINT"]</span>
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>
                <div class="fc-field">
                    <label class="fc-label" asp-for="Input.Password">@Localizer["LOGIN_PASSWORD_LABEL"]</label>
                    <input class="fc-input" asp-for="Input.Password" type="password" autocomplete="new-password" required aria-describedby="reg-pw-hint" />
                    <span id="reg-pw-hint" class="fc-hint">@Localizer["FC_PASSWORD_RULES"]</span>
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>
                <div class="fc-field">
                    <label class="fc-label" asp-for="Input.ConfirmPassword">@Localizer["FC_CONFIRM_PASSWORD"]</label>
                    <input class="fc-input" asp-for="Input.ConfirmPassword" type="password" autocomplete="new-password" required />
                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                </div>
                <div class="fc-field">
                    <label class="fc-label" for="upload-btn">@Localizer["FC_LOGO_TITLE"] <span class="fc-opt">— @Localizer["FC_OPTIONAL"]</span></label>
                    <input asp-for="Input.Image" id="upload-btn" type="file" accept="image/png, image/jpeg" />
                    <span class="fc-hint">@Localizer["FC_LOGO_HINT"]</span>
                </div>
                <button id="registerSubmit" type="submit" class="fc-btn fc-btn--primary fc-btn--lg fc-btn--block">@Localizer["FC_CREATE_ACCOUNT"]</button>
            </form>
        }
        else
        {
            <div class="fc-alert fc-alert--danger" role="alert">@Localizer["FC_INVITE_INVALID"]</div>
            <a asp-area="" asp-page="/Contact" class="fc-btn fc-btn--primary">@Localizer["FC_ASK_FOR_INVITE"]</a>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
