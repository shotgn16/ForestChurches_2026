@page
@model AccessDeniedModel
@{
    ViewData["Title"] = Localizer["FC_ACCESS_DENIED"];
}
<div class="fc-auth__form" style="flex: 1 0 auto; padding-top: 64px; padding-bottom: 64px">
    <div class="fc-auth__box fc-auth__box--card">
        <span class="fc-icon-tile" aria-hidden="true"><svg class="fc-icon" style="width: 26px; height: 26px" viewBox="0 0 24 24"><path d="M6 6l12 12M18 6L6 18"></path></svg></span>
        <h1 style="font-size: 30px">@Localizer["FC_ACCESS_DENIED"]</h1>
        <p class="fc-muted">@Localizer["FC_ACCESS_DENIED_TEXT"]</p>
        <div class="fc-btn-row">
            <a asp-page="./Login" class="fc-btn fc-btn--primary">@Localizer["FC_SIGN_IN"]</a>
            <a asp-area="" asp-page="/Contact" class="fc-btn fc-btn--quiet">@Localizer["NAV_CONTACT"]</a>
        </div>
    </div>
</div>
