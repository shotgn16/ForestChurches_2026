@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = Localizer["FC_RESET_PASSWORD"];
}

<div class="fc-auth__form" style="flex: 1 0 auto; padding-top: 64px; padding-bottom: 64px">
    <div class="fc-auth__box fc-auth__box--card">
        <span class="fc-icon-tile" aria-hidden="true"><svg class="fc-icon" style="width: 26px; height: 26px" viewBox="0 0 24 24"><rect x="5" y="11" width="14" height="10" rx="2"></rect><path d="M8 11V7a4 4 0 0 1 8 0v4"></path></svg></span>
        <div class="fc-stack" style="gap: 6px">
            <h1 style="font-size: 32px">@Localizer["FC_RESET_PASSWORD"]</h1>
            <p class="fc-muted">@Localizer["FC_RESET_LEAD"]</p>
        </div>
        <form method="post" class="fc-stack">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <div class="fc-field">
                <label class="fc-label" asp-for="Input.Email">@Localizer["LOGIN_EMAIL_LABEL"]</label>
                <input class="fc-input" asp-for="Input.Email" type="email" autocomplete="email" aria-required="true" required autofocus />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>
            <button type="submit" class="fc-btn fc-btn--primary fc-btn--lg fc-btn--block">@Localizer["FC_SEND_RESET_LINK"]</button>
        </form>
        <a asp-page="./Login" class="fc-small" style="font-weight: 700">← @Localizer["FC_BACK_TO_LOGIN"]</a>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
