@page
@model ResendEmailConfirmationModel
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<Program> Localizer
@{
    ViewData["Title"] = Localizer["RESEND_EMAIL_CONFIRMATION_TITLE"];
}
<head>
    <link rel="stylesheet"  href="~/css2/Login.css" asp-append-version="true" />
</head>

<body class="container-fluid text-center">
    <form method="post" class="form-signin">
        <!-- AntiforgeryToken -->
        @Html.AntiForgeryToken()

        <img class="mb-4" src="~/img/logo.png" alt="" width="300" height="200">
        <h1 class="h3 mb-3 font-weight-normal text-light">@Localizer["RESEND_EMAIL_CONFIRMATION_HEADING"]</h1>
            <input asp-for="Input.Email" class="form-control" aria-required="true" placeholder="@Localizer["RESEND_EMAIL_CONFIRMATION_PLACEHOLDER"]" required autofocus />
            <span asp-validation-for="Input.Email" class="text-danger"></span>

         <div class="form-container">
            <button type="submit" class="w-100 btn btn-lg btn-success">@Localizer["RESEND_EMAIL_CONFIRMATION_BUTTON"]</button>
        </div>
    </form>
</body>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}