@page
@model ForestChurches.Areas.Admin.Pages.Bulletin.IndexModel
@{
    Layout = "_Admin";
    ViewData["Title"] = "Manage Bulletins";
}

<div class="card">
    <div class="card-header">
        <h3 class="card-title">Bulletins</h3>
        <div class="card-tools">
            <a class="btn btn-primary" href="/Admin/Bulletin/Edit">Create / Edit Bulletin</a>
        </div>
    </div>
    <div class="card-body">
<p>
    <a class="btn btn-primary" href="/Admin/Bulletin/Edit">Create / Edit Bulletin</a>
</p>
@if (Model.Bulletins?.Any() ?? false)
{
    <table class="table">
        <thead>
            <tr>
                <th>Date</th>
                <th>Title</th>
                <th>Active</th>
                <th>Banner</th>
                <th>Expires</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var b in Model.Bulletins)
        {
            <tr>
                <td>@b.BulletinDate.ToString("yyyy-MM-dd")</td>
                <td>@b.Title</td>
                <td>
                    @if (b.IsActive)
                    {
                        <span class="badge bg-success">Active</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Inactive</span>
                    }
                </td>
                <td>
                    <form method="post" asp-page-handler="ToggleBanner" asp-route-id="@b.Id">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm @(b.BannerVisible ? "btn-warning" : "btn-outline-secondary")">@(b.BannerVisible ? "Hide" : "Show")</button>
                    </form>
                </td>
                <td>
                    <form method="post" asp-page-handler="SetExpiry" asp-route-id="@b.Id" class="d-inline-flex">
                        @Html.AntiForgeryToken()
                        <input type="datetime-local" name="expiresAt" value="@(b.BannerExpiresAt?.ToString("yyyy-MM-ddTHH:mm") ?? string.Empty)" class="form-control form-control-sm" />
                        <button type="submit" class="btn btn-sm btn-primary ms-2">Set</button>
                    </form>
                </td>
                <td class="text-end">
                    <a class="btn btn-sm btn-secondary" asp-page="/Admin/Bulletin/Edit" asp-route-id="@b.Id">Edit</a>
                    <form method="post" asp-page-handler="SetActive" asp-route-id="@b.Id" style="display:inline-block;margin-left:8px;">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-success">Make Active</button>
                    </form>
                    <form method="post" asp-page-handler="Delete" asp-route-id="@b.Id" style="display:inline-block;margin-left:8px;">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Delete this bulletin?');">Delete</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
}
else
{
    <p>No bulletins found.</p>
}

</div>
</div>
