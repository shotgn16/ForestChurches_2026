@* The Admin area had no _ViewImports, so tag helpers (asp-for, asp-page-handler…) and the
   Localizer weren't available to its pages and the bulletin form fields posted nothing. *@
@using ForestChurches
@namespace ForestChurches.Areas.Admin.Pages
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using Microsoft.AspNetCore.Http
@using Microsoft.AspNetCore.Mvc.Rendering
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<ForestChurches.SharedResources> Localizer
@inject IHttpContextAccessor HttpContextAccessor
