@using System.Globalization
@using Microsoft.AspNetCore.Http.Extensions

@{
    var currentCulture = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var cultureNames = new Dictionary<string, string>()
    {
        { "en", "English" },
        { "cs", "Čeština" },
        { "fa", "فارسی" },
        { "th", "ไทย" },
        { "uk", "Українська" },
        { "fr", "Français" },
        { "de", "Deutsch" }
    };

    // Build "same page, different culture" links on the server so no inline script is needed (CSP).
    string LinkFor(string culture)
    {
        var query = QueryString.Create(
            Context.Request.Query
                .Where(q => !string.Equals(q.Key, "culture", StringComparison.OrdinalIgnoreCase))
                .SelectMany(q => q.Value.Select(v => new KeyValuePair<string, string?>(q.Key, v)))
                .Append(new KeyValuePair<string, string?>("culture", culture)));
        return Context.Request.PathBase + Context.Request.Path + query.ToUriComponent();
    }

    var currentName = cultureNames.TryGetValue(currentCulture, out var n) ? n : "English";
}

<details class="fc-lang">
    <summary aria-label="@Localizer["FC_LANGUAGE"]: @currentName">
        <svg class="fc-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"></path></svg>
        @currentName
    </summary>
    <ul class="fc-lang__menu">
        @foreach (var culture in cultureNames)
        {
            <li><a href="@LinkFor(culture.Key)" lang="@culture.Key" aria-current="@(culture.Key == currentCulture ? "true" : null)">@culture.Value</a></li>
        }
    </ul>
</details>
