@* Light / dark switch. The choice is stored in the "fc-theme" cookie so the server can render the
   right theme straight away (no flash). Without a choice, the site follows the device setting. *@
<button type="button" class="fc-theme-toggle" data-fc-theme-toggle aria-label="@Localizer["FC_TOGGLE_THEME"]" title="@Localizer["FC_TOGGLE_THEME"]">
    <svg class="fc-icon fc-icon-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z"></path></svg>
    <svg class="fc-icon fc-icon-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
</button>
