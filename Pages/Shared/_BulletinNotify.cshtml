@using ForestChurches.Components.Bulletins
@inject IBulletinService BulletinService
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor

@{
    // Protect the site from startup/DB schema issues: if querying bulletins fails, fail silently.
    ForestChurches.Models.Bulletin? bulletin = null;
    // Prefer a bulletin explicitly marked for banner display. Fall back to active bulletin if not available.
    try
    {
        bulletin = await BulletinService.GetBannerBulletinAsync() ?? await BulletinService.GetActiveBulletinAsync();
    }
    catch
    {
        // If DB schema is out-of-date (missing column) or DB inaccessible, do not throw from layout.
        bulletin = null;
    }

    if (bulletin == null)
    {
        return;
    }

    // subtle notification: show a small banner under navbar for non-admin pages
    var user = HttpContextAccessor.HttpContext.User;
}

<div class="container-fluid bulletin-notify" style="background:linear-gradient(90deg,#E8F5E9,transparent);border-bottom:1px solid #E0E5DF;padding:8px 16px;z-index:9999;position:sticky;top:56px;">
    <div class="d-flex justify-content-between align-items-center">
        <div style="font-size:14px;color:#1B5E20;">
            <strong>New bulletin:</strong> @bulletin.Title — @bulletin.BulletinDate.ToString("d MMM yyyy")
        </div>
        <div>
            <a class="btn btn-sm btn-outline-success" asp-page="/Bulletin/Index">View</a>
        </div>
    </div>
</div>
