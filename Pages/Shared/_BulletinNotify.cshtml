@using ForestChurches.Components.Bulletins
@inject IBulletinService BulletinService

@{
    // Protect the site from startup/DB schema issues: if querying bulletins fails, fail silently.
    ForestChurches.Models.Bulletin? bulletin = null;
    // Prefer a bulletin explicitly marked for banner display. Fall back to active bulletin if not available.
    try
    {
        bulletin = await BulletinService.GetBannerBulletinAsync() ?? await BulletinService.GetActiveBulletinAsync();
    }
    catch
    {
        // If DB schema is out-of-date (missing column) or DB inaccessible, do not throw from layout.
        bulletin = null;
    }

    // Don't show the banner on the bulletin page itself.
    var onBulletinPage = string.Equals(ViewContext.RouteData.Values["page"]?.ToString(), "/Bulletin/Index", StringComparison.OrdinalIgnoreCase);

    if (bulletin == null || onBulletinPage)
    {
        return;
    }
}

<aside class="fc-banner" aria-label="@Localizer["FC_BULLETIN_BANNER_LABEL"]">
    <div class="fc-container fc-banner__inner">
        <span><strong>@Localizer["FC_BULLETIN_NEW"]</strong> @bulletin.Title — @bulletin.BulletinDate.ToString("d MMM yyyy")</span>
        <a asp-area="" asp-page="/Bulletin/Index">@Localizer["FC_BULLETIN_READ"]</a>
    </div>
</aside>
