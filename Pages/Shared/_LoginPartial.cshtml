@using ForestChurches.Components.Users
@using Microsoft.AspNetCore.Identity
@using ForestChurches.Areas.Identity.Data

@inject SignInManager<ChurchAccount> SignInManager

@if (SignInManager.IsSignedIn(User))
{
    <a id="manage" class="fc-nav__pill" asp-area="Identity" asp-page="/Account/Manage/ChurchProfile">@Localizer["FC_NAV_MY_CHURCH"]</a>
    <form id="logoutForm" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/Index", new { area = "" })" method="post">
        @Html.AntiForgeryToken()
        <button id="logout" type="submit" class="fc-nav__text-btn">@Localizer["NAV_LOGOUT"]</button>
    </form>
}
else
{
    <a class="fc-nav__pill" id="login" asp-area="Identity" asp-page="/Account/Login">@Localizer["FC_NAV_CHURCH_LOGIN"]</a>
}
