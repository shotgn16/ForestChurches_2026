@inject IHttpContextAccessor httpContext;
@{
    var url = $"{httpContext.HttpContext.Request.Scheme}://{httpContext.HttpContext.Request.Host.Value}";
    ViewData["Title"] = "";
}

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Forest Churches | Admin</title>
    
  <link href="~/@(nameof(ForestChurches)).styles.css" rel="stylesheet" />
  <!-- Google Font: Source Sans Pro -->
  <link rel="stylesheet" href="~/fonts/SourceSansPro.ttf" >
  <link rel="stylesheet" href="~/js/toastr.min.css" integrity="sha256-ENFZrbVzylNbgnXx0n3I1g//2WeO47XxoPe0vkp3NC8=" referrerpolicy="no-referrer" />
  <script src="~/js/toastr.min.js" integrity="sha256-3blsJd4Hli/7wCQ+bmgXfOdK7p/ZUMtPXY08jmxSSgk=" referrerpolicy="no-referrer"></script>
  <script src="~/js/32ff283d61.js" integrity="sha256-evmo5cYqZcNqcrajWANz/dV3fnm432TOBqs/UDh7+UE=" referrerpolicy="no-referrer"></script>

  <link rel="stylesheet" integrity="sha256-teON4y0UnyJj2Gol8NtuY0GOKW9cQvAE8a0Ve1Bi25Y=" href="~/plugins/fontawesome-free/css/all.min.css">
  <link rel="stylesheet" integrity="sha256-vdB1Qr2ck9tU7BlOV1srXHsCWGNH6cvV7lbT4h8+gs0=" href="~/css/adminlte.min.css">

  @RenderSection("Styles", required: false)
</head>
<style nonce="@HttpContextAccessor.HttpContext?.Items["CSP-Style-Nonce"]">
    .brand-image {
        opacity: .8
    }

    img {
        max-width: 100%;
    }
</style>

<body class="hold-transition sidebar-mini">
<!-- Site wrapper -->
<div class="wrapper">
  <!-- Navbar -->
  <nav class="main-header navbar navbar-expand navbar-white navbar-light">
    <!-- Left navbar links -->
    <ul class="navbar-nav">
      <li class="nav-item">
        <a class="nav-link" data-widget="pushmenu" href="#" role="button"><i class="fas fa-bars"></i></a>
      </li>
      <li class="nav-item d-none d-sm-inline-block">
        <a asp-page="/Admin/Index" class="nav-link">Home</a>
      </li>
    </ul>

    <!-- Right navbar links -->
    <ul class="navbar-nav ml-auto">

      <li class="nav-item">
        <a class="nav-link" data-widget="fullscreen" href="#" role="button">
          <i class="fas fa-expand-arrows-alt"></i>
        </a>
      </li>
    </ul>
  </nav>
  <!-- /.navbar -->

  <!-- Main Sidebar Container -->
  <aside class="main-sidebar sidebar-dark-primary elevation-4">
    <!-- Brand Logo -->
    <a asp-page="/Index" class="brand-link">
        <img src="~/img/admin_logo.png" alt="AdminLTE Logo" class="brand-image img-circle elevation-3">
      <span class="brand-text font-weight-light">Forest Churches</span>
    </a>

    <div class="sidebar">
      <nav class="mt-2">
        <ul class="nav nav-pills nav-sidebar flex-column" data-widget="treeview" role="menu" data-accordion="false">
            <li class="nav-item">
                <a asp-page="/Admin/Users/Index" class="nav-link">
                    <i class="nav-icon fa-solid fa-user"></i>
                    <p>Users</p>
                </a>
            </li>

            <li class="nav-item">
                <a asp-page="/Admin/Roles/Index" class="nav-link">
                <i class="nav-icon fas fa-solid fa-users"></i>
                    <p>Roles</p>
                </a>
            </li>

            <li class="nav-item">
                <a asp-page="/Admin/Events/Index" class="nav-link">
                    <i class="nav-icon fa-solid fa-calendar-days"></i>
                    <p>Events</p>
                </a>
            </li>

            <li class="nav-item">
                <a asp-page="/Admin/Invite" class="nav-link">
                    <i class="nav-icon fas fa-solid fa-list"></i>
                    <p>Whitelist Users</p>
                </a>
            </li>

            <li class="nav-item">
                <a asp-page="/Admin/Church/Index" class="nav-link">
                    <i class="nav-icon fas fa-solid fa-church"></i>
                    <p>Churches</p>
                </a>
            </li>

            <li class="nav-item">
                <a asp-page="/Admin/Contact" class="nav-link">
                    <i class="nav-icon fas fa-solid fa-envelope"></i>
                    <p>Emails</p>
                </a>
            </li>

            <li class="nav-item">
                <a asp-page="/Admin/Changelogs" class="nav-link">
                <i class="nav-icon fas fa-regular fa-rectangle-list"></i>
                    <p>Changelogs</p>
                </a>
            </li>

            <li class="nav-item">
                <a asp-page="/Admin/AdminLogs" class="nav-link">
                <i class="nav-icon fas fa-solid fa-code"></i>
                    <p>Logs</p>
                </a>
            </li>
        </ul>
      </nav>
      <!-- /.sidebar-menu -->
    </div>
    <!-- /.sidebar -->
  </aside>

  <!-- Content Wrapper. Contains page content -->
  <div class="content-wrapper">
    <!-- Content Header (Page header) -->
    <section class="content-header">
      <div class="container-fluid">
        <div class="row mb-2">
          <div class="col-md-3 col-sm-12 imageHeading">
            <img class="adminImage" src="~/img/admin_logo.png" alt="Forest Churches Logo" />
          </div>
          <div class="col-md-9 col-sm-12 textHeading">
          </div>
        </div>
      </div><!-- /.container-fluid -->
    </section>

    <!-- Main content -->
    <section class="content">
        @RenderBody()
      </div>
      <!-- /.card -->

    </section>
    <!-- /.content -->
  </div>
  <!-- /.content-wrapper -->

  <footer class="main-footer">
    <div class="float-right d-none d-sm-block">
      <b>Version</b> 3.2.0
    </div>
    <strong>Copyright &copy; 2025 <a href="@url">Forest Churches</a>.</strong>
  </footer>

  <!-- Control Sidebar -->
  <aside class="control-sidebar control-sidebar-dark">
    <!-- Control sidebar content goes here -->
  </aside>
  <!-- /.control-sidebar -->
</div>
<!-- ./wrapper -->

    <!-- jQuery -->
    <script src="~/lib/jquery/dist/jquery.min.js" asp-append-version="true" integrity="sha256-zp0HUArZHsK1JMJwdk7EyaM+eDINjTdOxADt5Ij2JRs="></script>
    <!-- Bootstrap 4 -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js" integrity="sha256-rAnWnVnzChxAAi8NS+Ilr1mE7Sj+do+X/DqyilNsznM="></script>
    <!-- AdminLTE App -->
    <script src="~/js//adminlte.min.js" asp-integrity="true"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>


<script nonce="@HttpContextAccessor.HttpContext?.Items["CSP-Script-Nonce"]">
    document.addEventListener("DOMContentLoaded", function () {
        setTimeout(() => {
            let msg = document.querySelector("#status-message");
            if (msg) {
                msg.style.opacity = "0";
                setTimeout(() => msg.remove(), 500);
            }
        }, 3000); // Auto-hide after 3 seconds
    });
</script>