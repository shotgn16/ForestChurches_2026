@* Site administration shell: the shared top bar (in admin mode) plus a sidebar of admin sections.
   Pages keep using Layout = "_Admin"; the area pages (Bulletins) use it too. *@
@{
    Layout = "/Pages/Shared/_Layout.cshtml";
    ViewData["FcShell"] = "admin";
    ViewData["FcShellTag"] = Localizer["FC_SITE_ADMIN"].Value;

    var area = ViewContext.RouteData.Values["area"]?.ToString() ?? string.Empty;
    var page = ViewContext.RouteData.Values["page"]?.ToString() ?? string.Empty;
    var path = string.IsNullOrEmpty(area) ? page : $"/{area}{page}";

    // A section is "current" when the page lives under it, e.g. /Admin/Users/Edit belongs to Users.
    bool IsIn(string section) => section == "/Admin/Index"
        ? string.Equals(path, section, StringComparison.OrdinalIgnoreCase)
        : path.StartsWith(section, StringComparison.OrdinalIgnoreCase);
    string? Current(string section) => IsIn(section) ? "page" : null;

    var sections = new (string Section, string Href, string Key)[]
    {
        ("/Admin/Index", Url.Page("/Admin/Index", new { area = "" })!, "FC_ADM_DASHBOARD"),
        ("/Admin/Users", Url.Page("/Admin/Users/Index", new { area = "" })!, "FC_ADM_USERS"),
        ("/Admin/Roles", Url.Page("/Admin/Roles/Index", new { area = "" })!, "FC_ADM_ROLES"),
        ("/Admin/Invite", Url.Page("/Admin/Invite", new { area = "" })!, "FC_ADM_INVITES"),
        ("/Admin/Church", Url.Page("/Admin/Church/Index", new { area = "" })!, "FC_ADM_CHURCHES"),
        ("/Admin/Events", Url.Page("/Admin/Events/Index", new { area = "" })!, "FC_ADM_EVENTS"),
        ("/Admin/Bulletin", Url.Page("/Bulletin/Index", new { area = "Admin" })!, "FC_NAV_BULLETINS"),
        ("/Admin/Contact", Url.Page("/Admin/Contact", new { area = "" })!, "FC_ADM_EMAILS"),
        ("/Admin/AdminLogs", Url.Page("/Admin/AdminLogs", new { area = "" })!, "FC_ADM_LOGS"),
        ("/Admin/Changelogs", Url.Page("/Admin/Changelogs", new { area = "" })!, "FC_ADM_CHANGELOG"),
    };
}

@section AdminBarLinks {
    <a asp-area="Identity" asp-page="/Account/Manage/ChurchProfile">@Localizer["FC_CHURCH_ADMIN"]</a>
    <a asp-area="" asp-page="/Index">@Localizer["FC_BACK_TO_SITE"]</a>
}

<div class="fc-container fc-admin">
    <nav class="fc-admin__side" aria-label="@Localizer["FC_SITE_ADMIN"]">
        <ul class="fc-sidenav">
            @foreach (var (section, href, key) in sections)
            {
                <li><a href="@href" class="@(IsIn(section) ? "active" : "")" aria-current="@Current(section)">@Localizer[key]</a></li>
            }
        </ul>
    </nav>

    <div class="fc-admin__main">
        @RenderBody()
    </div>
</div>

@section Scripts {
    @RenderSection("Scripts", required: false)
}
@if (IsSectionDefined("Styles")) { IgnoreSection("Styles"); }
