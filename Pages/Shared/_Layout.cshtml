@using Microsoft.Extensions.Localization
@{
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? string.Empty;
    string Current(params string[] pages) =>
        pages.Any(p => string.Equals(p, currentPage, StringComparison.OrdinalIgnoreCase)) ? "page" : null;

    var isAdminShell = string.Equals(ViewData["FcShell"] as string, "admin", StringComparison.Ordinal);
    var isChurchUser = User?.Identity?.IsAuthenticated == true &&
        (User.IsInRole(ForestChurches.Components.Roles.Roles.AuthorizedChurch.ToString()) || User.IsInRole(ForestChurches.Components.Roles.Roles.Admin.ToString()) || User.IsInRole(ForestChurches.Components.Roles.Roles.SuperAdmin.ToString()));
    var isSiteAdmin = User?.Identity?.IsAuthenticated == true &&
        (User.IsInRole(ForestChurches.Components.Roles.Roles.Admin.ToString()) || User.IsInRole(ForestChurches.Components.Roles.Roles.SuperAdmin.ToString()));
    var pageTitle = ViewData["Title"]?.ToString();
    var brand = Localizer["NAV_BRAND"].Value;
}
<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(string.IsNullOrWhiteSpace(pageTitle) ? brand : $"{pageTitle} – {brand}")</title>
    <meta name="theme-color" content="#1F3D2B" />
    <link rel="icon" href="~/favicon.ico" type="image/x-icon" asp-append-version="true" />

    <script src="~/js/jquery-3.7.1.min.js"></script>
    @* Bootstrap is kept for the modals/dropdowns still used by a few pages; forest.css restyles them. *@
    <link rel="stylesheet" href="~/css2/Bootstrap/bootstrap2.min.css" />
    <link rel="stylesheet" href="~/js/fontawsome.min.css" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="~/ForestChurches.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/forest.css" asp-append-version="true" />
    @await RenderSectionAsync("Head", required: false)
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="fc-body @(isAdminShell ? "fc-body--admin" : "")">
    <a class="fc-skip" href="#main">@Localizer["FC_SKIP_TO_CONTENT"]</a>

    @if (isAdminShell)
    {
        <header class="fc-adminbar">
            <div class="fc-container fc-adminbar__inner">
                <a class="fc-adminbar__brand" asp-area="" asp-page="/Index">
                    <span>@brand</span>
                    <span class="fc-adminbar__tag">@Localizer["FC_CHURCH_ADMIN"]</span>
                </a>
                <div class="fc-adminbar__links">
                    @RenderSection("AdminBarLinks", required: false)
                    <span class="fc-adminbar__user">@User?.Identity?.Name</span>
                    <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/Index", new { area = "" })" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit">@Localizer["NAV_LOGOUT"]</button>
                    </form>
                </div>
            </div>
        </header>
    }
    else
    {
        <header class="fc-header">
            <div class="fc-container fc-header__inner">
                <a class="fc-brand" asp-area="" asp-page="/Index">
                    <img src="~/img/logo.png" alt="" width="52" height="32" />
                    <span>@brand</span>
                </a>
                <button class="fc-nav-toggle" type="button" data-fc-nav-toggle aria-controls="fc-nav" aria-expanded="false">@Localizer["FC_MENU"]</button>
                <nav id="fc-nav" class="fc-nav" aria-label="@Localizer["FC_MAIN_NAV"]">
                    <ul class="fc-nav__list">
                        <li><a class="fc-nav__link" asp-area="" asp-page="/Index" aria-current="@Current("/Index", "/NearMe")">@Localizer["FC_NAV_FIND"]</a></li>
                        <li><a class="fc-nav__link" asp-area="" asp-page="/Bulletin/Index" aria-current="@Current("/Bulletin/Index")">@Localizer["FC_NAV_BULLETIN"]</a></li>
                        <li><a class="fc-nav__link" asp-area="" asp-page="/Aboutus" aria-current="@Current("/Aboutus")">@Localizer["NAV_ABOUT"]</a></li>
                        <li><a class="fc-nav__link" asp-area="" asp-page="/Contact" aria-current="@Current("/Contact")">@Localizer["NAV_CONTACT"]</a></li>
                        @if (isChurchUser)
                        {
                            <li><a class="fc-nav__link" asp-area="" asp-page="/Events/Index" aria-current="@Current("/Events/Index")">@Localizer["NAV_MY_EVENTS"]</a></li>
                        }
                        @if (isSiteAdmin)
                        {
                            <li><a class="fc-nav__link" asp-area="" asp-page="/Admin/Index">@Localizer["NAV_ADMIN"]</a></li>
                        }
                    </ul>
                    <div class="fc-nav__actions">
                        <partial name="_LanguageSwitcher" />
                        <partial name="_LoginPartial" />
                    </div>
                </nav>
            </div>
        </header>
        @await Html.PartialAsync("_BulletinNotify")
    }

    <main id="main" role="main">
        @RenderBody()
    </main>

    @if (!isAdminShell)
    {
        <footer class="fc-footer">
            <div class="fc-container fc-footer__inner">
                <span>© @DateTime.UtcNow.Year @brand</span>
                <nav class="fc-footer__links" aria-label="@Localizer["FC_FOOTER_NAV"]">
                    <a asp-area="" asp-page="/Privacy">@Localizer["FC_PRIVACY"]</a>
                    <a asp-area="" asp-page="/faq">@Localizer["FC_FAQ"]</a>
                    <a asp-area="" asp-page="/Contact">@Localizer["FOOTER_CONTACT_LINK"]</a>
                </nav>
            </div>
        </footer>
    }

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/forest.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

    @* MiniProfiler integration with CSP Nonce *@
    <mini-profiler nonce="@Context.Items["CSP-Script-Nonce"]" />
</body>
</html>
