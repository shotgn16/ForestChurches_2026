</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-transparent sticky-top w-100" id="mainNavbar">
            <div class="container-fluid">
                <a class="navbar-brand" asp-page="/Index">@Localizer["NAV_BRAND"]</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="#navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Index">@Localizer["NAV_HOME"]</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/aboutus">@Localizer["NAV_ABOUT"]</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/NearMe">@Localizer["NAV_WHATS_NEARBY"]</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Bulletin/Index">Bulletin</a>
                        </li>
                        @if (User?.Identity?.IsAuthenticated == true)
                        {
                            @if (User?.IsInRole(ForestChurches.Components.Roles.Roles.AuthorizedChurch.ToString()) == true || User?.IsInRole(ForestChurches.Components.Roles.Roles.Admin.ToString()) == true || User?.IsInRole(ForestChurches.Components.Roles.Roles.SuperAdmin.ToString()) == true)
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-area="" asp-page="/Events/Index">@Localizer["NAV_MY_EVENTS"]</a>
                                </li>
                            }
                        }
                        <li>
                            <a class="nav-link" asp-area="" asp-page="/Contact">@Localizer["NAV_CONTACT"]</a>
                        </li>
                        @if (User?.Identity?.IsAuthenticated == true)
                        {
                            @if (User?.IsInRole(ForestChurches.Components.Roles.Roles.Admin.ToString()) == true || User?.IsInRole(ForestChurches.Components.Roles.Roles.SuperAdmin.ToString()) == true)
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-area="" asp-page="/Admin/Index">@Localizer["NAV_ADMIN"]</a>
                                </li>
                            }
                        }
                    </ul>
                    <div class="d-flex align-items-center gap-2">
                        <partial name="_LanguageSwitcher" />
                        <partial name="_LoginPartial" />
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div id="wrapper">
        <div class="container-fluid">
            <main role="main" class="site-main p-0">
                @RenderBody()
            </main>
        </div>
                <footer class="border-top footer">
            <div class="container-fluid footer-container">
                <a asp-area="" asp-page="/Contact">@Localizer["FOOTER_CONTACT_LINK"]</a>
            </div>
        </footer>

        <script src="~/js/site.js" asp-append-version="true"></script>
        <script src="~/lib/jquery/dist/jquery.min.js" asp-append-version="true"></script>
        <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
        <script src="~/js/layout.js"></script>

        <script>
            // Ensure CSS variable --navbar-height matches the actual navbar height
            (function () {
                function setNavbarHeight() {
                    try {
                        var nav = document.getElementById('mainNavbar');
                        if (!nav) return;
                        var h = nav.offsetHeight;
                        document.documentElement.style.setProperty('--navbar-height', h + 'px');
                    } catch (e) { /* ignore */ }
                }
                document.addEventListener('DOMContentLoaded', setNavbarHeight);
                window.addEventListener('resize', setNavbarHeight);
            })();
        </script>

        @await RenderSectionAsync("Scripts", required: false)

        @* MiniProfiler integration with CSP Nonce *@
        <mini-profiler nonce="@Context.Items["CSP-Script-Nonce"]" />
    </div>
</body>
</html>
