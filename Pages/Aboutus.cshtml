@page
@model ForestChurches.Pages.AboutusModel
@{
}
<head>
    <link rel="stylesheet" href="~/css2/Page-header.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css2/Variables.css" asp-append-version="true" />
</head>
<style nonce="@HttpContextAccessor.HttpContext?.Items["CSP-Style-Nonce"]">
    .rounded-circle {
        padding-bottom: 2%;
    }
    #page-footer {
        color: white;
        font-size: smaller;
        text-align: center;
    }
    .col-lg-4 {
        text-align: center;
    }
    main {
        background-color: #00AD6A;
    }

    .container.marketing {
        padding-top: 5%;
        padding-bottom: 10%;
    }
</style>

<!-- Beginning of Page header -->
<div class="container-fluid page-hero">
    <div class="hero-text">
        <h1>@Localizer["ABOUTUS_PAGE_TITLE"]</h1>
        <p>@Localizer["ABOUTUS_PAGE_SUBTITLE"]</p>
    </div>
</div>

@* Bulletin notify for this page *@
@await Html.PartialAsync("_BulletinNotify")

<!-- Content goes here -->
<div class="container marketing">
    <!-- Three columns of text below the carousel -->
    <div class="row">
        <div class="col-lg-4">
            <img class="rounded-circle" src="~/img/aboutus_dear.jpeg" alt="@Localizer["ABOUTUS_COMMUNITY_IMAGE_ALT"]" width="140" height="140">
            <h1>@Localizer["ABOUTUS_COMMUNITY_SECTION_TITLE"]</h1>
            <!-- RE-WRITE (28.01.2025) -->
            <p>@Localizer["ABOUTUS_COMMUNITY_SECTION_TEXT"]</p>
        </div><!-- /.col-lg-4 -->
        <div class="col-lg-4">
            <img class="rounded-circle" src="~/img/aboutus_stream.jpeg" alt="@Localizer["ABOUTUS_SUPPORT_IMAGE_ALT"]" width="140" height="140">
            <h1>@Localizer["ABOUTUS_BELIEF_SECTION_TITLE"]</h1>
            <p>@Localizer["ABOUTUS_BELIEF_SECTION_TEXT"]</p>
        </div>
        <div class="col-lg-4">
            <img class="rounded-circle" src="~/img/aboutus_leaves.jpeg" alt="@Localizer["ABOUTUS_LIGHT_IMAGE_ALT"]" width="140" height="140">
            <h1>@Localizer["ABOUTUS_LIGHT_SECTION_TITLE"]</h1>
            <p>@Localizer["ABOUTUS_LIGHT_SECTION_TEXT"]</p>
        </div>
    </div><!-- /.row -->
    <div class="col-lg-12">
        <p id="page-footer">@Localizer["ABOUTUS_FOOTER_TEXT"]</p>
    </div>
</div>
