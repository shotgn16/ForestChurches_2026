@page
@model ForestChurches.Pages.Admin.InviteModel
@inject ForestChurches.Components.Security.Encoder Encoder
@{
    Layout = "_Admin";
    ViewData["Title"] = Localizer["FC_ADM_INVITES"];
    var invites = (Model.invites ?? new List<ForestChurches.Models.WhitelistedUsers>())
        .OrderBy(i => i.Status == "Pending" ? 0 : 1).ThenByDescending(i => i.ExpiryDate).ToList();
    var now = DateTime.UtcNow;
}

<div class="fc-page-head">
    <div>
        <h1>@Localizer["FC_ADM_INVITES"]</h1>
        <p>@Localizer["FC_ADM_INVITES_LEAD"]</p>
    </div>
</div>

<partial name="_StatusMessage" model="Model.StatusMessage" />

<section class="fc-card" aria-labelledby="invite-h">
    <h2 id="invite-h" class="fc-h3" style="margin-bottom: 12px">@Localizer["FC_ADM_INVITE_CHURCH"]</h2>
    <form id="registrationInvite" method="post" asp-page-handler="AddWhitelistedUser" class="fc-inline-form">
        <div class="fc-field">
            <label class="fc-label" for="emailInput">@Localizer["LOGIN_EMAIL_LABEL"]</label>
            <input id="emailInput" type="email" class="fc-input" name="email" autocomplete="off" aria-describedby="invite-hint" required />
        </div>
        <button class="fc-btn fc-btn--primary" type="submit">@Localizer["FC_ADM_SEND_INVITE"]</button>
    </form>
    <p class="fc-hint" id="invite-hint" style="margin-top: 10px">@Localizer["FC_ADM_INVITE_HINT"]</p>
</section>

<section class="fc-card fc-card--flush" aria-labelledby="invites-h">
    <div class="fc-card__head">
        <h2 id="invites-h" class="fc-h3">@Localizer["FC_ADM_INVITE_LIST"]</h2>
        <span class="fc-small fc-muted">@Localizer["FC_ADM_N_INVITES", invites.Count]</span>
    </div>
    @if (invites.Count == 0)
    {
        <p class="fc-muted" style="padding: 0 22px 22px">@Localizer["FC_ADM_NO_INVITES"]</p>
    }
    else
    {
        <div class="fc-table-wrap">
            <table class="fc-table fc-table--admin fc-table--stack">
                <thead>
                    <tr>
                        <th scope="col">@Localizer["LOGIN_EMAIL_LABEL"]</th>
                        <th scope="col">@Localizer["FC_ADM_STATUS"]</th>
                        <th scope="col">@Localizer["FC_ADM_LINK_EXPIRES"]</th>
                        <th scope="col">@Localizer["FC_ADM_REGISTERED"]</th>
                        <th scope="col"><span class="fc-sr-only">@Localizer["FC_ADM_ACTIONS"]</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var invite in invites)
                    {
                        var protectedEmail = Encoder.Protect(invite.Email, "fc.data.admin.invite");
                        var pending = invite.Status == "Pending";
                        var expired = pending && invite.ExpiryDate < now;
                        var registered = invite.DateOfRegistration > DateTime.MinValue.AddYears(1);
                        <tr>
                            <td class="fc-break"><strong>@invite.Email</strong></td>
                            <td data-label="@Localizer["FC_ADM_STATUS"]">
                                @if (!pending)
                                {
                                    <span class="fc-badge fc-badge--ok">@Localizer["FC_ADM_INVITE_COMPLETE"]</span>
                                }
                                else if (expired)
                                {
                                    <span class="fc-badge fc-badge--danger">@Localizer["FC_ADM_INVITE_EXPIRED"]</span>
                                }
                                else
                                {
                                    <span class="fc-badge fc-badge--warn">@Localizer["FC_ADM_INVITE_PENDING"]</span>
                                }
                            </td>
                            <td data-label="@Localizer["FC_ADM_LINK_EXPIRES"]" class="fc-nowrap">@(pending ? ForestChurches.Components.Ui.FcText.UkDateTime(invite.ExpiryDate) : "—")</td>
                            <td data-label="@Localizer["FC_ADM_REGISTERED"]" class="fc-nowrap">@(registered ? ForestChurches.Components.Ui.FcText.UkDateTime(invite.DateOfRegistration, "d MMM yyyy") : "—")</td>
                            <td>
                                <div class="fc-actions">
                                    @if (pending)
                                    {
                                        <form method="post" asp-page-handler="ResendInvite">
                                            <input type="hidden" name="email" value="@protectedEmail" />
                                            <button class="fc-btn fc-btn--quiet fc-btn--sm" type="submit">@Localizer["FC_ADM_RESEND"]<span class="fc-sr-only"> @invite.Email</span></button>
                                        </form>
                                    }
                                    <form method="post" asp-page-handler="RemoveWhitelistedUser" data-fc-confirm="@Localizer["FC_ADM_CONFIRM_REMOVE_INVITE", invite.Email]">
                                        <input type="hidden" name="email" value="@protectedEmail" />
                                        <button class="fc-btn fc-btn--danger-outline fc-btn--sm" type="submit">@Localizer["FC_ADM_REMOVE"]<span class="fc-sr-only"> @invite.Email</span></button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
