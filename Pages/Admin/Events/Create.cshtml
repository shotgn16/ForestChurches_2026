@page
@model ForestChurches.Pages.Admin.Events.CreateModel
@using ForestChurches.Components.Ui
@inject ForestChurches.Components.Security.Encoder Encoder
@{
    Layout = "_Admin";
    ViewData["Title"] = Localizer["FC_ADD_EVENT"];
    var repeatOptions = new (string Value, string Key)[]
    {
        ("None", "FC_REPEAT_NONE"), ("Daily", "FC_REPEAT_DAILY"), ("Weekly", "FC_REPEAT_WEEKLY"),
        ("Every 2 weeks", "FC_REPEAT_2W"), ("Every 3 weeks", "FC_REPEAT_3W"),
        ("Monthly", "FC_REPEAT_MONTHLY"), ("Every 2 months", "FC_REPEAT_2M"),
    };
}

<div class="fc-page-head">
    <div>
        <a asp-page="./Index" class="fc-small" style="font-weight: 700">← @Localizer["FC_ADM_EVENTS"]</a>
        <h1 style="margin-top: 6px">@Localizer["FC_ADD_EVENT"]</h1>
    </div>
</div>

<partial name="_StatusMessage" model="Model.StatusMessage" />

<section class="fc-card">
    <form id="creationForm" asp-page-handler="CreateEvent" enctype="multipart/form-data" method="post" class="fc-stack fc-stack--lg">
        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
        <div class="fc-grid">
            <div class="fc-field fc-span-all">
                <label class="fc-label" asp-for="Input.Name">@Localizer["FC_EVENT_NAME"]</label>
                <input class="fc-input" type="text" asp-for="Input.Name" value="@FcText.PlainText(Model.Input?.Name)" aria-required="true" />
                <span asp-validation-for="Input.Name" class="text-danger"></span>
            </div>
            <div class="fc-field">
                <label class="fc-label" for="selectedUser">@Localizer["FC_ADM_EVENT_OWNER"]</label>
                <select class="fc-select" name="SelectedUsername" id="selectedUser" required aria-describedby="owner-hint">
                    <option value="">@Localizer["FC_ADM_CHOOSE_ACCOUNT"]</option>
                    @foreach (var user in Model.UserList ?? new List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>())
                    {
                        <option value="@Encoder.Protect(user.Value, "fc.data.admin.events")" selected="@(user.Value == Model.SelectedUsername)">@user.Text</option>
                    }
                </select>
                <span class="fc-hint" id="owner-hint">@Localizer["FC_ADM_EVENT_OWNER_HINT"]</span>
            </div>
            <div class="fc-field">
                <label class="fc-label" for="repeatEvent">@Localizer["FC_REPEATS"]</label>
                <select class="fc-select" asp-for="Input.Repeats" id="repeatEvent">
                    @foreach (var (value, key) in repeatOptions)
                    {
                        <option value="@value">@Localizer[key]</option>
                    }
                </select>
            </div>
            <div class="fc-field">
                <label class="fc-label" asp-for="Input.Date">@Localizer["NEARME_DATE_LABEL"]</label>
                <input class="fc-input" type="date" asp-for="Input.Date" aria-required="true" />
                <span asp-validation-for="Input.Date" class="text-danger"></span>
            </div>
            <div class="fc-field">
                <label class="fc-label" asp-for="Input.StartTime">@Localizer["FC_STARTS"]</label>
                <input class="fc-input" type="time" asp-for="Input.StartTime" aria-required="true" />
                <span asp-validation-for="Input.StartTime" class="text-danger"></span>
            </div>
            <div class="fc-field">
                <label class="fc-label" asp-for="Input.EndTime">@Localizer["FC_ENDS"]</label>
                <input class="fc-input" type="time" asp-for="Input.EndTime" aria-required="true" />
                <span asp-validation-for="Input.EndTime" class="text-danger"></span>
            </div>
            <div class="fc-field fc-span-all">
                <label class="fc-label" asp-for="Input.Address">@Localizer["NEARME_LOCATION_LABEL"]</label>
                <input class="fc-input" type="text" asp-for="Input.Address" value="@FcText.PlainText(Model.Input?.Address)" aria-required="true" />
                <span asp-validation-for="Input.Address" class="text-danger"></span>
            </div>
            <div class="fc-field fc-span-all">
                <label class="fc-label" for="Input_Description">@Localizer["FC_DESCRIPTION"]</label>
                <textarea class="fc-textarea" id="Input_Description" name="Input.Description" rows="4" aria-required="true">@FcText.PlainText(Model.Input?.Description)</textarea>
                <span asp-validation-for="Input.Description" class="text-danger"></span>
            </div>
            <div class="fc-field">
                <label class="fc-label" asp-for="Input.Link">@Localizer["FC_EVENT_LINK"] <span class="fc-opt">— @Localizer["FC_OPTIONAL"]</span></label>
                <input class="fc-input" type="text" asp-for="Input.Link" value="@(string.IsNullOrWhiteSpace(Model.Input?.Link) ? "None" : Model.Input.Link)" />
                <span asp-validation-for="Input.Link" class="text-danger"></span>
            </div>
            <div class="fc-field">
                <label class="fc-label" for="Input_Image">@Localizer["FC_EVENT_IMAGE"] <span class="fc-opt">— @Localizer["FC_OPTIONAL"]</span></label>
                <input asp-for="Input.Image" type="file" accept="image/png, image/jpeg" />
            </div>
        </div>
        <div class="fc-btn-row" style="justify-content: flex-end">
            <a asp-page="./Index" class="fc-btn fc-btn--quiet">@Localizer["FC_CANCEL"]</a>
            <button id="submitEvent" type="submit" class="fc-btn fc-btn--primary">@Localizer["FC_CREATE_EVENT"]</button>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
