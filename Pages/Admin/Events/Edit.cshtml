@page
@model ForestChurches.Pages.Admin.Events.EditModel
@inject ForestChurches.Components.Security.Encoder Encoder;
@inject ForestChurches.Components.Storage.IBlobUrlService BlobUrlService;
@{
    Layout = "_Admin";
}
<partial name="_StatusMessage" model="Model.StatusMessage" />
<style nonce="@HttpContextAccessor.HttpContext?.Items["CSP-Style-Nonce"]">
    .slider {
        font-size: calc(0.2rem + 1.0vw);
    }

    .frequencyLabel {
        margin-bottom: calc(1.0rem + 1.0vw);
    }

    #eventImage {
        max-width: 100px;
    }
</style>

<!-- Profile Image -->
<div class="card card-primary card-outline">
    <div class="card-body box-profile">
        <div class="text-center">
            @if (Encoder.HtmlEncode(Model.currentEvent?.ImageArray) != null)
            {
                <img id="eventImage" src="data:image;base64,@System.Convert.ToBase64String(Model.currentEvent.ImageArray)" />
            }
            else if (Model.currentEvent is null || Model.currentEvent.ImageArray is null)
            {
                // IMGUR-1
                <img id="eventImage" src=@BlobUrlService.GetReadSasUrl("IMGUR-1.png", TimeSpan.FromDays(1)) />
            }
        </div>

        <h3 class="profile-username text-center">@Encoder.HtmlEncode(Model.currentEvent.Name)</h3>

        <p class="text-muted text-center">@Encoder.HtmlEncode(Model.currentEvent.Name)</p>

        <div class="tab-pane active" id="settings">
            <form id="editForm" asp-page-handler="UpdateEvent" enctype="multipart/form-data" method="post">
                <!-- AntiforgeryToken -->
                @Html.AntiForgeryToken()

                <!-- Event Name -->
                <div class="form-floating mb-3">
                    <label asp-for="Input.Name">Event Name</label>
                    <input type="text" asp-for="Input.Name" class="form-control" autocomplete="on" aria-required="true" required>
                    <span asp-validation-for="Input.Name" class="text-danger"></span>
                </div>

                <!-- Event Description -->
                <div class="form-floating mb-3">
                    <label asp-for="Input.Description">Event Description</label>
                    <input type="text" asp-for="Input.Description" class="form-control" autocomplete="on" aria-required="true" required>
                    <span asp-validation-for="Input.Description" class="text-danger"></span>
                </div>

                <!-- Event Location -->
                <div class="form-floating mb-3">
                    <label asp-for="Input.Address">Where will the event be?</label>
                    <input type="text" asp-for="Input.Address" class="form-control" autocomplete="on" aria-required="true" required>
                    <span asp-validation-for="Input.Address" class="text-danger"></span>
                </div>

                <!-- Event Date -->
                <div class="form-floating mb-3">
                    <label asp-for="Input.Date">When will the event be?</label>
                    <input type="date" asp-for="Input.Date" class="form-control" autocomplete="on" aria-required="true" required>
                    <span asp-validation-for="Input.Date" class="text-danger"></span>
                </div>

                <!-- Event Start Time -->
                <div class="form-floating mb-3">
                    <label asp-for="Input.StartTime">When will it start?</label>
                    <input type="time" asp-for="Input.StartTime" class="form-control" autocomplete="on" aria-required="true" required>
                    <span asp-validation-for="Input.StartTime" class="text-danger"></span>
                </div>

                <!-- Event End Time -->
                <div class="form-floating mb-3">
                    <label asp-for="Input.EndTime">When will it finish?</label>
                    <input type="time" asp-for="Input.EndTime" class="form-control" autocomplete="on" aria-required="true" required>
                    <span asp-validation-for="Input.EndTime" class="text-danger"></span>
                </div>

                <!-- Event Link -->
                <div class="form-floating mb-3">
                    <label asp-for="Input.Link">Any relevant links?</label>
                    <input type="text" asp-for="Input.Link" class="form-control" autocomplete="on" aria-required="true" value="None" />
                    <span asp-validation-for="Input.Link" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label for="selectedUser">User</label>
                    <select asp-for="SelectedUsername" class="form-control" id="selectedUser" required>
                        <option value="">Select a user</option>
                        @foreach (var user in Model.UserList)
                        {
                            <option value="@Encoder.Protect(user.Value, "fc.data.admin.events")">@Encoder.HtmlEncode(user.Text)</option>
                        }
                    </select>
                </div>

                <!-- Event Repeats -->
                <div class="form-group">
                    <label asp-for="Input.Repeats">How often does your event repeat?</label>
                    <select asp-for="Input.Repeats" class="form-control" id="repeatEvent">
                        <option value="None">None</option>
                        <option value="Daily">Daily</option>
                        <option value="Weekly">Weekly</option>
                        <option value="Every 2 weeks">Every 2 weeks</option>
                        <option value="Every 3 weeks">Every 3 weeks</option>
                        <option value="Monthly">Monthly</option>
                        <option value="Every 2 months">Every 2 months</option>
                    </select>
                    <span asp-validation-for="Input.Repeats" class="text-danger"></span>
                </div>

                <!-- Event Photo -->
                <div class="form-group">
                    <label asp-for="Input.Image"></label>
                    <input asp-for="Input.Image" type="file" class="form-control" />
                    <span asp-validation-for="Input.Image" class="text-danger"></span>
                </div>

                <input type="hidden" name="id" value="@Encoder.Protect(Model.currentEvent.ID, "fc.data.admin.events")" />

                <button id="submitEvent" type="submit" class="btn btn-lg btn-primary">Submit</button>
            </form>
        </div>
    </div>
</div>

@section scripts {
    <script src="~/plugins/dropzone/min/dropzone.min.js" integrity="sha256-uCdT6FLkY6+68Xzm4f9O0usHnJPdKv0Q0rsoXvLchP4="></script>
}