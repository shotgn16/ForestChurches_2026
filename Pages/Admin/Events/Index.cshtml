@page
@model ForestChurches.Pages.Admin.Events.IndexModel
@using ForestChurches.Components.Ui
@inject ForestChurches.Components.Security.Encoder Encoder
@inject ForestChurches.Components.Storage.IBlobUrlService BlobUrlService
@{
    Layout = "_Admin";
    ViewData["Title"] = Localizer["FC_ADM_EVENTS"];
    var today = DateOnly.FromDateTime(DateTime.Today);
    var all = Model.Events ?? new List<ForestChurches.Models.EventsModel>();
    var groups = new (string Id, string TitleKey, List<ForestChurches.Models.EventsModel> Items)[]
    {
        ("upcoming", "FC_UPCOMING_EVENTS", all.Where(e => e.Date >= today).OrderBy(e => e.Date).ThenBy(e => e.StartTime).ToList()),
        ("past", "FC_ADM_PAST_EVENTS", all.Where(e => e.Date < today).OrderByDescending(e => e.Date).ThenBy(e => e.StartTime).ToList()),
    };

    string? Thumb(ForestChurches.Models.EventsModel e)
    {
        if (!string.IsNullOrEmpty(e.ImageBlobName)) return BlobUrlService.GetReadSasUrl(e.ImageBlobName, TimeSpan.FromHours(1));
        return e.ImageArray is { Length: > 1 } ? "data:image;base64," + Convert.ToBase64String(e.ImageArray) : null;
    }

    static bool HasLink(string? link) => Uri.TryCreate(link, UriKind.Absolute, out var u) && (u.Scheme == "http" || u.Scheme == "https");
}

<div class="fc-page-head">
    <div>
        <h1>@Localizer["FC_ADM_EVENTS"]</h1>
        <p>@Localizer["FC_ADM_EVENTS_LEAD"]</p>
    </div>
    <a asp-page="/Admin/Events/Create" class="fc-btn fc-btn--primary">+ @Localizer["FC_ADD_EVENT"]</a>
</div>

<partial name="_StatusMessage" model="Model.StatusMessage" />

@foreach (var (id, titleKey, items) in groups)
{
    <section class="fc-card fc-card--flush" aria-labelledby="@id-h">
        <div class="fc-card__head">
            <h2 id="@id-h" class="fc-h3">@Localizer[titleKey]</h2>
            <span class="fc-small fc-muted">@Localizer["FC_EVENT_COUNT", items.Count]</span>
        </div>
        @if (items.Count == 0)
        {
            <p class="fc-muted" style="padding: 0 22px 22px">@Localizer["FC_ADM_NO_EVENTS"]</p>
        }
        else
        {
            <div class="fc-table-wrap">
                <table class="fc-table fc-table--admin fc-table--stack">
                    <thead>
                        <tr>
                            <th scope="col">@Localizer["FC_EVENT_NAME"]</th>
                            <th scope="col">@Localizer["FC_ADM_WHEN"]</th>
                            <th scope="col">@Localizer["FC_ADM_CHURCH"]</th>
                            <th scope="col"><span class="fc-sr-only">@Localizer["FC_ADM_ACTIONS"]</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var e in items)
                        {
                            var protectedId = Encoder.Protect(e.ID, "fc.data.admin.events");
                            var name = FcText.PlainText(e.Name);
                            var thumb = Thumb(e);
                            var repeats = string.IsNullOrWhiteSpace(e.Repeats) || e.Repeats is "None" or "No" ? null : FcText.PlainText(e.Repeats);
                            <tr>
                                <td>
                                    <div class="fc-who">
                                        @if (thumb != null)
                                        {
                                            <img class="fc-thumb" src="@thumb" alt="" width="64" height="48" loading="lazy" />
                                        }
                                        <div style="min-width: 0">
                                            <strong>@name</strong>
                                            <span class="fc-tiny fc-muted" style="display: block">@FcText.Excerpt(e.Address, 80)</span>
                                            @if (HasLink(e.Link))
                                            {
                                                <a href="@e.Link" class="fc-tiny fc-break" rel="noopener" target="_blank">@(new Uri(e.Link).Host)</a>
                                            }
                                        </div>
                                    </div>
                                </td>
                                <td data-label="@Localizer["FC_ADM_WHEN"]">
                                    <span class="fc-nowrap">@e.Date.ToString("ddd d MMM yyyy")</span>
                                    <span class="fc-small fc-muted" style="display: block">@FcText.TimeRange(e.StartTime, e.EndTime)@(repeats == null ? "" : " · " + repeats)</span>
                                </td>
                                <td data-label="@Localizer["FC_ADM_CHURCH"]">
                                    @FcText.PlainText(e.Church)
                                    <span class="fc-tiny fc-muted fc-break" style="display: block">@e.User</span>
                                </td>
                                <td>
                                    <div class="fc-actions">
                                        <a asp-page="Edit" asp-route-id="@protectedId" class="fc-btn fc-btn--quiet fc-btn--sm">@Localizer["FC_EDIT"]<span class="fc-sr-only"> @name</span></a>
                                        <form method="post" asp-page-handler="DownloadEvent">
                                            <input type="hidden" name="value" value="@protectedId" />
                                            <button class="fc-btn fc-btn--quiet fc-btn--sm" type="submit">@Localizer["FC_ADM_DOWNLOAD"]<span class="fc-sr-only"> @name</span></button>
                                        </form>
                                        <form method="post" asp-page-handler="DeleteEvent" data-fc-confirm="@Localizer["FC_CONFIRM_DELETE_EVENT", name]">
                                            <input type="hidden" name="value" value="@protectedId" />
                                            <button class="fc-btn fc-btn--danger-outline fc-btn--sm" type="submit">@Localizer["FC_DELETE"]<span class="fc-sr-only"> @name</span></button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
}
