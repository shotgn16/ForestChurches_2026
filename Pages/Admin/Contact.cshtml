@page
@model ForestChurches.Pages.Admin.ContactModel
@inject ForestChurches.Components.Security.Encoder Encoder
@{
    Layout = "_Admin";
    ViewData["Title"] = Localizer["FC_ADM_EMAILS"];
}

<div class="fc-page-head">
    <div>
        <h1>@Localizer["FC_ADM_EMAILS"]</h1>
        <p>@Localizer["FC_ADM_EMAILS_LEAD"]</p>
    </div>
</div>

<partial name="_StatusMessage" model="Model.StatusMessage" />

<section class="fc-card" style="max-width: 760px">
    <form method="post" class="fc-stack fc-stack--lg">
        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

        <div class="fc-field">
            <label class="fc-label" for="selectedUser">@Localizer["FC_ADM_RECIPIENT"]</label>
            <select class="fc-select" name="Input.ClientEmail" id="selectedUser" required>
                <option value="">@Localizer["FC_ADM_CHOOSE_RECIPIENT"]</option>
                @foreach (var user in Model.UserList ?? new List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>())
                {
                    <option value="@Encoder.Protect(user.Value, "fc.data.admin.contact")">@(user.Value == "All" ? Localizer["FC_ADM_ALL_USERS"].Value : user.Text)</option>
                }
            </select>
        </div>

        <div class="fc-field">
            <label class="fc-label" asp-for="Input.Name">@Localizer["FC_ADM_SIGN_OFF_AS"]</label>
            <input class="fc-input" type="text" asp-for="Input.Name" autocomplete="name" aria-describedby="name-hint" />
            <span class="fc-hint" id="name-hint">@Localizer["FC_ADM_SIGN_OFF_HINT"]</span>
        </div>

        <div class="fc-field">
            <label class="fc-label" asp-for="Input.Message">@Localizer["FC_ADM_MESSAGE"]</label>
            <textarea class="fc-textarea" asp-for="Input.Message" rows="8" required></textarea>
            <span asp-validation-for="Input.Message" class="text-danger"></span>
        </div>

        <p class="fc-hint">@Localizer["FC_ADM_EMAIL_FROM_HINT"]</p>

        <div class="fc-btn-row" style="justify-content: flex-end">
            <button type="submit" class="fc-btn fc-btn--primary">@Localizer["FC_ADM_SEND_MESSAGE"]</button>
        </div>
    </form>
</section>
