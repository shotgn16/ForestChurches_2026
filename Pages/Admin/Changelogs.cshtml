@page
@model ForestChurches.Pages.Admin.ChangelogsModel
@{
    Layout = "_Admin";
    ViewData["Title"] = Localizer["FC_ADM_CHANGELOG"];

    // Release notes are written for the site's administrators, so they're kept in English.
    var releases = new (string Version, string Date, string[] Notes)[]
    {
        ("2.0.0", "October 2026", new[]
        {
            "New \"Forest Floor\" design across the public site, church admin and site admin.",
            "Dark mode, with a toggle in the header that remembers your choice.",
            "Search results now show distances, a map of the results, and options to download or email a church's details.",
            "Fixed the /Events page crashing, and church pages no longer error on old or invalid links.",
            "Fixed text showing stray HTML codes, duplicated headings and text, and unlabelled form fields.",
            "Service and event times now display consistently (24-hour, UK dates).",
            "Placeholder text replaced and translations completed for every language in the language menu.",
            "Site admin: church list and edit pages now require an admin account, editing a church updates the right church, events keep their picture when other details change, and roles in use can no longer be deleted.",
        }),
        ("1.0.1", "27 February 2025", new[]
        {
            "Status messages now close after 5 seconds.",
            "Removed the ability for users to change their email address.",
            "Added Frequently Asked Questions.",
            "Fixed broken icons on the admin dashboard.",
            "Fixed the \"checkered effect\" on the church page.",
            "Removed the seeded demonstration user.",
        }),
        ("1.0.0", "1 February 2025", new[]
        {
            "Account registration, sign-in and account management.",
            "Event management for each account.",
            "Church profile management.",
            "HTTPS enforced for every request.",
            "Admin management of users, events and churches.",
            "Invite-only registration (only invited email addresses can register).",
            "Role-based access across the site.",
            "Default developer and admin accounts seeded.",
            "Real-time logging to Seq, plus logging to the database.",
            "Email to one user or all users at once.",
            "Contact page with pre-filled emails.",
        }),
    };
}

<div class="fc-page-head">
    <div>
        <h1>@Localizer["FC_ADM_CHANGELOG"]</h1>
        <p>@Localizer["FC_ADM_CHANGELOG_LEAD"]</p>
    </div>
</div>

<section class="fc-card">
    <ol class="fc-timeline">
        @foreach (var (version, date, notes) in releases)
        {
            <li>
                <h2 class="fc-h3">@Localizer["FC_ADM_RELEASE", version]</h2>
                <p class="fc-small fc-muted">@date</p>
                <ul>
                    @foreach (var note in notes) { <li>@note</li> }
                </ul>
            </li>
        }
    </ol>
</section>
