@page
@using ForestChurches.Models
@model ForestChurches.Pages.Admin.Roles.EditModel
@inject ForestChurches.Components.Security.Encoder Encoder;
@{
    Layout = "_Admin";
}
<partial name="_StatusMessage" model="Model.StatusMessage" />

<div class="card">
    <div class="card-header">
        <h3 class="card-title">Manage Roles | <strong>@Model.Role.Name</strong></h3>
    </div>
    <div class="card-body">
        <form method="post">
            <!-- AntiforgeryToken -->
            @Html.AntiForgeryToken()

            <input type="hidden" name="roleId" value="@Encoder.Protect(Model.Role.Id, "fc.data.admin.role")" />
            <table class="table">
                <thead>
                    <tr>
                        <th>Permission</th>
                        <th>Allowed/Disallowed</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.AllPermissions != null)
                    {
                        foreach (var permission in Model.AllPermissions)
                        {
                            <tr>
                                <td>@permission.Name</td> <!-- Updated to display permission name -->
                                <td>
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" value="@Encoder.Protect(permission.Id, "fc.data.admin.role")" name="selectedPermissions" id="@permission.Id" checked="@(Model.Role.RolePermissions?.Any(rp => rp.PermissionId == permission.Id) ?? false)">
                                        <label class="form-check-label" for="@permission.Id"></label> <!-- Updated to use Permission Id for the label 'for' attribute -->
                                    </div>
                                </td>
                                
                            </tr>
                        }
                    }
                </tbody>
            </table>

            <button type="submit">Save</button>
        </form>
    </div>
</div>
