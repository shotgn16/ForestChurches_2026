@page
@model ForestChurches.Pages.Admin.Users.RegisterModel
@inject ForestChurches.Components.Security.Encoder Encoder
@{
    Layout = "_Admin";
    ViewData["Title"] = Localizer["FC_ADM_CREATE_USER"];
    var assigned = Model.Input?.Roles ?? new List<string>();
    var roles = (Model.Roles ?? new List<ForestChurches.Components.Roles.ChurchRoles>()).Where(r => !string.IsNullOrEmpty(r.Name)).ToList();
}

<div class="fc-page-head">
    <div>
        <a asp-page="./Index" class="fc-small" style="font-weight: 700">← @Localizer["FC_ADM_USERS"]</a>
        <h1 style="margin-top: 6px">@Localizer["FC_ADM_CREATE_USER"]</h1>
        <p>@Localizer["FC_ADM_CREATE_USER_LEAD"]</p>
    </div>
</div>

<partial name="_StatusMessage" model="Model.StatusMessage" />

<section class="fc-card">
    <form id="registerForm" asp-page-handler="RegisterUser" enctype="multipart/form-data" method="post" class="fc-stack fc-stack--lg">
        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

        <div class="fc-field" style="max-width: 520px">
            <label class="fc-label" asp-for="Input.Email">@Localizer["LOGIN_EMAIL_LABEL"]</label>
            <input class="fc-input" asp-for="Input.Email" type="email" autocomplete="off" aria-required="true" />
            <span asp-validation-for="Input.Email" class="text-danger"></span>
        </div>

        <div class="fc-grid">
            <div class="fc-field">
                <label class="fc-label" asp-for="Input.Password">@Localizer["LOGIN_PASSWORD_LABEL"]</label>
                <div class="fc-pw">
                    <input class="fc-input" asp-for="Input.Password" autocomplete="new-password" aria-required="true" aria-describedby="pw-rules" />
                    <button type="button" class="fc-pw__toggle" data-fc-pw-toggle aria-controls="Input_Password" aria-pressed="false" data-show="@Localizer["FC_SHOW"]" data-hide="@Localizer["FC_HIDE"]">@Localizer["FC_SHOW"]</button>
                </div>
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>
            <div class="fc-field">
                <label class="fc-label" asp-for="Input.ConfirmPassword">@Localizer["FC_CONFIRM_PASSWORD"]</label>
                <input class="fc-input" asp-for="Input.ConfirmPassword" autocomplete="new-password" aria-required="true" />
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
            </div>
        </div>
        <p class="fc-hint" id="pw-rules" style="margin-top: -12px">@Localizer["FC_PASSWORD_RULES"]</p>

        <fieldset class="fc-stack" style="border: 0; padding: 0; margin: 0">
            <legend class="fc-label" style="margin-bottom: 4px">@Localizer["FC_ADM_ROLES"]</legend>
            @if (roles.Count == 0)
            {
                <p class="fc-muted">@Localizer["FC_ADM_NO_ROLES"]</p>
            }
            else
            {
                <div class="fc-checks">
                    @foreach (var role in roles)
                    {
                        var roleId = "role-" + role.Id;
                        <label class="fc-check" for="@roleId">
                            <input id="@roleId" type="checkbox" name="Input.Roles" value="@Encoder.Protect(role.Name, "fc.data.admin.users")" checked="@assigned.Contains(role.Name ?? string.Empty)" />
                            @role.Name
                        </label>
                    }
                </div>
            }
        </fieldset>

        <div class="fc-field" style="max-width: 520px">
            <label class="fc-label" for="Input_Image">@Localizer["FC_ADM_PROFILE_IMAGE"] <span class="fc-opt">— @Localizer["FC_OPTIONAL"]</span></label>
            <input asp-for="Input.Image" type="file" accept="image/png, image/jpeg" />
            <span asp-validation-for="Input.Image" class="text-danger"></span>
        </div>

        <div class="fc-btn-row" style="justify-content: flex-end">
            <a asp-page="./Index" class="fc-btn fc-btn--quiet">@Localizer["FC_CANCEL"]</a>
            <button type="submit" class="fc-btn fc-btn--primary">@Localizer["FC_ADM_CREATE_USER"]</button>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
