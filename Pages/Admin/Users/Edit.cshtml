@page
@model ForestChurches.Pages.Admin.Users.EditModel
@inject ForestChurches.Components.Security.Encoder Encoder
@inject ForestChurches.Components.Storage.IBlobUrlService BlobUrlService
@{
    Layout = "_Admin";
    ViewData["Title"] = Localizer["FC_ADM_EDIT_USER"];
    var user = Model.CurrentUser;
    var assigned = Model.Input?.Roles ?? new List<string>();
    var allRoles = (Model.Roles ?? new List<ForestChurches.Components.Roles.ChurchRoles>()).Where(r => !string.IsNullOrEmpty(r.Name)).ToList();
    var avatar = user == null ? null
        : !string.IsNullOrEmpty(user.ImageBlobName) ? BlobUrlService.GetReadSasUrl(user.ImageBlobName, TimeSpan.FromHours(1))
        : user.ImageArray is { Length: > 1 } ? "data:image;base64," + Convert.ToBase64String(user.ImageArray)
        : BlobUrlService.GetReadSasUrl("IMGUR-1.png", TimeSpan.FromHours(1));
}

<div class="fc-page-head">
    <div>
        <a asp-page="./Index" class="fc-small" style="font-weight: 700">← @Localizer["FC_ADM_USERS"]</a>
        <h1 style="margin-top: 6px">@Localizer["FC_ADM_EDIT_USER"]</h1>
    </div>
</div>

<partial name="_StatusMessage" model="Model.StatusMessage" />

@if (user == null)
{
    <div class="fc-card fc-empty">
        <h2 class="fc-h3">@Localizer["FC_ADM_USER_NOT_FOUND"]</h2>
        <p class="fc-muted" style="margin-top: 8px"><a asp-page="./Index">@Localizer["FC_ADM_BACK_TO_USERS"]</a></p>
    </div>
}
else
{
    <section class="fc-card">
        <div class="fc-who" style="margin-bottom: 22px">
            <img class="fc-avatar fc-avatar--lg" src="@avatar" alt="" width="72" height="72" />
            <div>
                <strong style="font-size: 20px">@user.UserName</strong>
                <span class="fc-small fc-muted">@(user.EmailConfirmed ? Localizer["FC_ADM_ACCOUNT_CONFIRMED"] : Localizer["FC_ADM_ACCOUNT_UNCONFIRMED"])</span>
            </div>
        </div>

        <form asp-page-handler="UpdateUser" method="post" class="fc-stack fc-stack--lg">
            <input type="hidden" name="id" value="@Encoder.Protect(user.Id, "fc.data.admin.users")" />
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

            <div class="fc-grid">
                <div class="fc-field">
                    <label class="fc-label" asp-for="Input.Email">@Localizer["LOGIN_EMAIL_LABEL"]</label>
                    <input class="fc-input" type="email" asp-for="Input.Email" autocomplete="off" />
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>
                <div class="fc-field">
                    <label class="fc-label" asp-for="Input.Phone">@Localizer["FC_PHONE"] <span class="fc-opt">— @Localizer["FC_OPTIONAL"]</span></label>
                    <input class="fc-input" type="tel" asp-for="Input.Phone" autocomplete="off" />
                </div>
            </div>

            <fieldset class="fc-stack" style="border: 0; padding: 0; margin: 0">
                <legend class="fc-label" style="margin-bottom: 4px">@Localizer["FC_ADM_ROLES"]</legend>
                <p class="fc-hint">@Localizer["FC_ADM_ROLES_HINT"]</p>
                <div class="fc-checks">
                    @foreach (var role in allRoles)
                    {
                        var roleId = "role-" + role.Id;
                        <label class="fc-check" for="@roleId">
                            <input id="@roleId" type="checkbox" name="Input.Roles" value="@Encoder.Protect(role.Name, "fc.data.admin.users")" checked="@assigned.Contains(role.Name ?? string.Empty)" />
                            @role.Name
                        </label>
                    }
                </div>
            </fieldset>

            <div class="fc-switches">
                <label class="fc-switch" for="statusCheckbox">
                    @Localizer["FC_ADM_EMAIL_CONFIRMED"]
                    <input type="checkbox" asp-for="Input.IsActive" id="statusCheckbox" />
                </label>
            </div>

            <div class="fc-field" style="max-width: 420px">
                <label class="fc-label" for="Input_Password">@Localizer["FC_ADM_NEW_PASSWORD"] <span class="fc-opt">— @Localizer["FC_OPTIONAL"]</span></label>
                <div class="fc-pw">
                    <input class="fc-input" id="Input_Password" name="Input.Password" type="password" autocomplete="new-password" aria-describedby="pw-hint" />
                    <button type="button" class="fc-pw__toggle" data-fc-pw-toggle aria-controls="Input_Password" aria-pressed="false" data-show="@Localizer["FC_SHOW"]" data-hide="@Localizer["FC_HIDE"]">@Localizer["FC_SHOW"]</button>
                </div>
                <span class="fc-hint" id="pw-hint">@Localizer["FC_ADM_PASSWORD_BLANK_HINT"]</span>
            </div>

            <div class="fc-btn-row" style="justify-content: flex-end">
                <a asp-page="./Index" class="fc-btn fc-btn--quiet">@Localizer["FC_CANCEL"]</a>
                <button type="submit" class="fc-btn fc-btn--primary">@Localizer["FC_SAVE_CHANGES"]</button>
            </div>
        </form>
    </section>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
