@page
@model ForestChurches.Pages.Admin.Users.IndexModel
@inject ForestChurches.Components.Security.Encoder Encoder
@inject ForestChurches.Components.Storage.IBlobUrlService BlobUrlService
@{
    Layout = "_Admin";
    ViewData["Title"] = Localizer["FC_ADM_USERS"];
    var users = Model.Users ?? new List<ForestChurches.Components.Users.ChurchAccount>();
    var roles = Model.UserRoles ?? new Dictionary<string, List<string>>();
    var defaultAvatar = BlobUrlService.GetReadSasUrl("IMGUR-1.png", TimeSpan.FromHours(1));
    const string superAdmin = nameof(ForestChurches.Components.Roles.Roles.SuperAdmin);
    const string admin = nameof(ForestChurches.Components.Roles.Roles.Admin);
    const string church = nameof(ForestChurches.Components.Roles.Roles.AuthorizedChurch);
}

<div class="fc-page-head">
    <div>
        <h1>@Localizer["FC_ADM_USERS"]</h1>
        <p>@Localizer["FC_ADM_USERS_LEAD"]</p>
    </div>
</div>

<partial name="_StatusMessage" model="Model.StatusMessage" />

<section class="fc-card" aria-labelledby="new-user-h">
    <h2 id="new-user-h" class="fc-h3" style="margin-bottom: 12px">@Localizer["FC_ADM_CREATE_USER"]</h2>
    <form id="createUserForm" method="get" asp-page="/Admin/Users/Register" class="fc-inline-form">
        <div class="fc-field">
            <label class="fc-label" for="usernameInput">@Localizer["LOGIN_EMAIL_LABEL"]</label>
            <input id="usernameInput" type="email" class="fc-input" name="username" autocomplete="off" required />
        </div>
        <button class="fc-btn fc-btn--primary" type="submit">@Localizer["FC_ADM_CONTINUE"]</button>
    </form>
</section>

<section class="fc-card fc-card--flush" aria-labelledby="users-h">
    <div class="fc-card__head">
        <h2 id="users-h" class="fc-h3">@Localizer["FC_ADM_REGISTERED_USERS"]</h2>
        <span class="fc-small fc-muted">@Localizer["FC_ADM_N_USERS", users.Count]</span>
    </div>
    @if (users.Count == 0)
    {
        <p class="fc-muted" style="padding: 0 22px 22px">@Localizer["FC_ADM_NO_USERS"]</p>
    }
    else
    {
        <div class="fc-table-wrap">
            <table class="fc-table fc-table--admin fc-table--stack">
                <thead>
                    <tr>
                        <th scope="col">@Localizer["FC_ADM_USER"]</th>
                        <th scope="col">@Localizer["FC_ADM_STATUS"]</th>
                        <th scope="col">@Localizer["FC_ADM_ROLES"]</th>
                        <th scope="col">@Localizer["FC_ADM_EMAIL_CONFIRMED"]</th>
                        <th scope="col"><span class="fc-sr-only">@Localizer["FC_ADM_ACTIONS"]</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in users)
                    {
                        var userRoles = roles.TryGetValue(user.Id, out var r) ? r : new List<string>();
                        var protectedId = Encoder.Protect(user.Id, "fc.data.admin.users");
                        var name = user.UserName ?? user.Email ?? string.Empty;
                        var avatar = !string.IsNullOrEmpty(user.ImageBlobName)
                            ? BlobUrlService.GetReadSasUrl(user.ImageBlobName, TimeSpan.FromHours(1))
                            : user.ImageArray is { Length: > 1 } ? "data:image;base64," + Convert.ToBase64String(user.ImageArray) : defaultAvatar;
                        <tr>
                            <td>
                                <div class="fc-who">
                                    <img class="fc-avatar" src="@avatar" alt="" width="40" height="40" loading="lazy" />
                                    <div>
                                        <strong>@name</strong>
                                        @if (!string.IsNullOrWhiteSpace(user.PhoneNumber))
                                        {
                                            <span class="fc-small fc-muted">@user.PhoneNumber</span>
                                        }
                                    </div>
                                </div>
                            </td>
                            <td data-label="@Localizer["FC_ADM_STATUS"]">
                                @if (userRoles.Contains(superAdmin))
                                {
                                    <span class="fc-badge fc-badge--cs">@Localizer["FC_ADM_ROLE_DEVELOPER"]</span>
                                }
                                else if (userRoles.Contains(admin))
                                {
                                    <span class="fc-badge fc-badge--moss">@Localizer["FC_ADM_ROLE_ADMIN"]</span>
                                }
                                else if (userRoles.Contains(church))
                                {
                                    <span class="fc-badge fc-badge--ok">@Localizer["FC_ADM_ROLE_APPROVED"]</span>
                                }
                                else
                                {
                                    <span class="fc-badge fc-badge--warn">@Localizer["FC_ADM_ROLE_PENDING"]</span>
                                }
                            </td>
                            <td data-label="@Localizer["FC_ADM_ROLES"]">
                                @if (userRoles.Count == 0)
                                {
                                    <span class="fc-muted">—</span>
                                }
                                <span class="fc-tags">
                                    @foreach (var role in userRoles) { <span class="fc-tag">@role</span> }
                                </span>
                            </td>
                            <td data-label="@Localizer["FC_ADM_EMAIL_CONFIRMED"]">@(user.EmailConfirmed ? Localizer["FC_YES"] : Localizer["FC_NO"])</td>
                            <td>
                                <div class="fc-actions">
                                    <a asp-page="Edit" asp-route-id="@protectedId" class="fc-btn fc-btn--quiet fc-btn--sm">@Localizer["FC_EDIT"]<span class="fc-sr-only"> @name</span></a>
                                    <form method="post" asp-page-handler="DownloadUser">
                                        <input type="hidden" name="value" value="@protectedId" />
                                        <button class="fc-btn fc-btn--quiet fc-btn--sm" type="submit">@Localizer["FC_ADM_DOWNLOAD"]<span class="fc-sr-only"> @name</span></button>
                                    </form>
                                    @if (!userRoles.Contains(superAdmin))
                                    {
                                        <form method="post" asp-page-handler="DeleteUser" data-fc-confirm="@Localizer["FC_ADM_CONFIRM_DELETE_USER", name]">
                                            <input type="hidden" name="value" value="@protectedId" />
                                            <button class="fc-btn fc-btn--danger-outline fc-btn--sm" type="submit">@Localizer["FC_DELETE"]<span class="fc-sr-only"> @name</span></button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
