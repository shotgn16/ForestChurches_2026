@page
@using ForestChurches.Components.Logging
@model ForestChurches.Pages.Admin.AdminLogsModel
@inject LogRetriver _logRetriver
@{
    Layout = "_Admin";
    var cspNonce = HttpContext.Items["CSP-Script-Nonce"]?.ToString() ?? string.Empty;
}
<head>
    <link rel="stylesheet" integrity="sha256-teON4y0UnyJj2Gol8NtuY0GOKW9cQvAE8a0Ve1Bi25Y=" href="~/plugins/fontawesome-free/css/all.min.css">
</head>

<div id="adminLogsRoot" data-current-page="@Model.CurrentPage" data-total-pages="@Model.TotalPages" data-search="@Model.SearchQuery">
    @Html.AntiForgeryToken()
    <div class="mb-2 d-flex gap-2 flex-wrap">
        <input id="searchInput" type="search" class="form-control" placeholder="Search logs..." value="@Model.SearchQuery" style="max-width: 200px;" />
        <button id="searchBtn" class="btn btn-primary">Search</button>
    </div>

    <div class="mb-3 d-flex gap-2 flex-wrap align-items-end">
        <div>
            <label for="fromDate" class="form-label">From Date/Time:</label>
            <input id="fromDate" type="datetime-local" class="form-control" />
        </div>
        <div>
            <label for="toDate" class="form-label">To Date/Time:</label>
            <input id="toDate" type="datetime-local" class="form-control" />
        </div>
        <button id="downloadBtn" class="btn btn-success">Download Logs</button>
    </div>

    <div style="overflow-x:auto; overflow-y:scroll; height: 650px;">
        <table class="table table-bordered table-striped">
            <thead>
                <tr>
                    <th class="sticky-header">Timestamp</th>
                    <th class="sticky-header">Level</th>
                    <th class="sticky-header">Exception</th>
                    <th class="sticky-header">RenderedMessage</th>
                </tr>
            </thead>
            <tbody id="logsTableBody">
                @foreach (var log in Model.Logs)
                {
                    <tr style="color: @(log.Level == "Debug" ? "darkgray" : log.Level == "Warning" ? "orange" : log.Level == "Error" ? "red" : "black");">
                        <td>@Html.Encode(log.Timestamp)</td>
                        <td>@Html.Encode(log.Level)</td>
                        <td>@Html.Encode(log.Exception)</td>
                        <td>@Html.Encode(log.Message)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="d-flex justify-content-between align-items-center mt-2">
        <div>
            <button id="prevBtn" class="btn btn-secondary">Previous</button>
            <button id="nextBtn" class="btn btn-secondary">Next</button>
        </div>
        <div>Page <span id="currentPage">@Model.CurrentPage</span> of <span id="totalPages">@Model.TotalPages</span></div>
    </div>
</div>

@section Scripts {
    <script src="@(Url.Content("~/lib/signalr/signalr.min.js"))" nonce="@cspNonce"></script>
    <script src="@(Url.Content("~/js/admin-logs.js"))" nonce="@cspNonce"></script>
}