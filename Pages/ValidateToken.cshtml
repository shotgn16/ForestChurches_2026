@page
@model ForestChurches.Pages.ValidateTokenModel
@{
    ViewData["Title"] = Localizer["TOKEN_VALIDATION_PAGE_TITLE"];
}
<head>
    <link rel="stylesheet" href="~/css2/profile.css" asp-append-version="true" />
</head>
<style nonce="@HttpContextAccessor.HttpContext?.Items["CSP-Style-Nonce"]">
    h1 {
        text-align: center;
        padding-top: calc(1.0rem + 1.0vw);
    }

    section {
        padding-top: calc(10.0rem + 1.0vw);
        text-align: center;
        top: 50%;
        bottom: 50%;
        inline-size: fit-content;
        vertical-align: central;
        color: white;
    }

    img {
        max-width: calc(4.0rem + 1.0vw);
    }

    #subtitle {
        color: lightgrey;
    }
</style>


<section>
    <img alt="Invalid Token" src="~/img/cross.png" />
    <h1>@Localizer["TOKEN_VALIDATION_PAGE_TITLE"]</h1>

    @if (Model.IsValidating)
    {
        <p>@Localizer["TOKEN_VALIDATION_VALID_REDIRECTING"];</p>
    }
    else if (Model.IsTokenValid)
    {
        <p>@Localizer["TOKEN_VALIDATION_VALID_REDIRECTING"];</p>
    }
    else
    {
        <p>@Localizer["TOKEN_VALIDATION_INVALID_EXPIRED"];</p>
        <p id="subtitle"><a href="@Request.Scheme://@Request.Host">here</a></p>
    }

</section>

