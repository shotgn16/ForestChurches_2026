@page
@model ForestChurches.Pages.faqModel
@{
    ViewData["Title"] = Localizer["FAQ_PAGE_TITLE"];
    var visitorQuestions = new[] { 2, 4, 8 };
    var churchQuestions = new[] { 1, 6, 5, 7, 3 };
}

<div class="fc-container fc-container--narrow fc-section" style="padding-top: 64px; padding-bottom: 72px">
    <div class="fc-stack fc-stack--lg">
        <div class="fc-stack" style="gap: 12px">
            <p class="fc-eyebrow">@Localizer["FC_HELP"]</p>
            <h1 class="fc-display">@Localizer["FAQ_PAGE_TITLE"]</h1>
            <p class="fc-lead">@Localizer["FAQ_INTRO_TEXT"] <a asp-page="/Contact" style="font-weight: 700">@Localizer["FC_SEND_US_A_MESSAGE"]</a>.</p>
        </div>

        <section class="fc-stack" style="gap: 10px" aria-labelledby="faq-visitors">
            <h2 id="faq-visitors" style="font-size: 26px; margin-bottom: 4px">@Localizer["FAQ_SECTION_TITLE"]</h2>
            @foreach (var i in visitorQuestions)
            {
                <details class="fc-acc" open="@(i == visitorQuestions[0])">
                    <summary>@Localizer[$"FAQ_Q{i}_TITLE"]</summary>
                    <div class="fc-acc__body">@Localizer[$"FAQ_Q{i}_ANSWER"]</div>
                </details>
            }
        </section>

        <section class="fc-stack" style="gap: 10px" aria-labelledby="faq-churches">
            <h2 id="faq-churches" style="font-size: 26px; margin-bottom: 4px">@Localizer["FC_FAQ_CHURCHES_TITLE"]</h2>
            @foreach (var i in churchQuestions)
            {
                <details class="fc-acc">
                    <summary>@Localizer[$"FAQ_Q{i}_TITLE"]</summary>
                    <div class="fc-acc__body">@Localizer[$"FAQ_Q{i}_ANSWER"]</div>
                </details>
            }
        </section>
    </div>
</div>
