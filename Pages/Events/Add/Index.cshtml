@page
@model ForestChurches.Pages.Events.Add.IndexModel
@{
    Layout = "/Areas/Identity/Pages/Account/Manage/_Layout.cshtml";
    ViewData["ActivePage"] = "Events";
    ViewData["Title"] = Localizer["FC_ADD_EVENT"];
    var repeatOptions = new (string Value, string Key)[]
    {
        ("None", "FC_REPEAT_NONE"), ("Daily", "FC_REPEAT_DAILY"), ("Weekly", "FC_REPEAT_WEEKLY"),
        ("Every 2 weeks", "FC_REPEAT_2W"), ("Every 3 weeks", "FC_REPEAT_3W"),
        ("Monthly", "FC_REPEAT_MONTHLY"), ("Every 2 months", "FC_REPEAT_2M"),
    };
}

<div class="fc-page-head">
    <div>
        <a asp-page="/Events/Index" class="fc-small" style="font-weight: 700">← @Localizer["EVENTS_PAGE_TITLE"]</a>
        <h1 style="margin-top: 6px">@Localizer["FC_ADD_EVENT"]</h1>
    </div>
</div>

<partial name="_StatusMessage" model="Model.StatusMessage" />

<section class="fc-card">
    <form id="eventForm" enctype="multipart/form-data" method="post" class="fc-stack fc-stack--lg">
        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
        <div class="fc-grid">
            <div class="fc-field fc-span-all">
                <label class="fc-label" asp-for="Input.Name">@Localizer["FC_EVENT_NAME"]</label>
                <input class="fc-input" type="text" asp-for="Input.Name" aria-required="true" />
                <span asp-validation-for="Input.Name" class="text-danger"></span>
            </div>
            <div class="fc-field">
                <label class="fc-label" asp-for="Input.Date">@Localizer["NEARME_DATE_LABEL"]</label>
                <input class="fc-input" type="date" asp-for="Input.Date" aria-required="true" />
                <span asp-validation-for="Input.Date" class="text-danger"></span>
            </div>
            <div class="fc-field">
                <label class="fc-label" asp-for="Input.StartTime">@Localizer["FC_STARTS"]</label>
                <input class="fc-input" type="time" asp-for="Input.StartTime" aria-required="true" />
                <span asp-validation-for="Input.StartTime" class="text-danger"></span>
            </div>
            <div class="fc-field">
                <label class="fc-label" asp-for="Input.EndTime">@Localizer["FC_ENDS"]</label>
                <input class="fc-input" type="time" asp-for="Input.EndTime" aria-required="true" />
                <span asp-validation-for="Input.EndTime" class="text-danger"></span>
            </div>
            <div class="fc-field">
                <label class="fc-label" for="repeatEvent">@Localizer["FC_REPEATS"]</label>
                <select class="fc-select" asp-for="Input.Repeats" id="repeatEvent">
                    @foreach (var (value, key) in repeatOptions)
                    {
                        <option value="@value">@Localizer[key]</option>
                    }
                </select>
                <span asp-validation-for="Input.Repeats" class="text-danger"></span>
            </div>
            <div class="fc-field fc-span-all">
                <label class="fc-label" asp-for="Input.Address">@Localizer["NEARME_LOCATION_LABEL"]</label>
                <input class="fc-input" type="text" asp-for="Input.Address" aria-required="true" autocomplete="street-address" />
                <span asp-validation-for="Input.Address" class="text-danger"></span>
            </div>
            <div class="fc-field fc-span-all">
                <label class="fc-label" asp-for="Input.Description">@Localizer["FC_DESCRIPTION"]</label>
                <textarea class="fc-textarea" asp-for="Input.Description" rows="4" aria-required="true"></textarea>
                <span asp-validation-for="Input.Description" class="text-danger"></span>
            </div>
            <div class="fc-field">
                <label class="fc-label" asp-for="Input.Link">@Localizer["FC_EVENT_LINK"] <span class="fc-opt">— @Localizer["FC_OPTIONAL"]</span></label>
                <input class="fc-input" type="text" asp-for="Input.Link" value="None" />
                <span asp-validation-for="Input.Link" class="text-danger"></span>
            </div>
            <div class="fc-field">
                <label class="fc-label" for="upload-btn">@Localizer["FC_EVENT_IMAGE"] <span class="fc-opt">— @Localizer["FC_OPTIONAL"]</span></label>
                <input asp-for="Input.Image" id="upload-btn" type="file" accept="image/png, image/jpeg" />
            </div>
        </div>
        <input asp-for="Input.User" type="hidden" value="Default Value" />
        <input asp-for="Input.Church" type="hidden" value="Default Value" />
        <input asp-for="Input.SelectedUsername" type="hidden" value="Default Value" />
        <div class="fc-btn-row" style="justify-content: flex-end">
            <a asp-page="/Events/Index" class="fc-btn fc-btn--quiet">@Localizer["FC_CANCEL"]</a>
            <button id="submitEvent" type="submit" class="fc-btn fc-btn--primary">@Localizer["FC_CREATE_EVENT"]</button>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
