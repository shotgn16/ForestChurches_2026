@model List<ForestChurches.Models.EventsModel>
@using ForestChurches.Components.Ui
@inject ForestChurches.Components.Security.Encoder Encoder;

@foreach (var item in Model)
{
    var protectedId = Encoder.Protect(item.ID, "fc.data.user.events");
    var name = FcText.PlainText(item.Name);
    var fromChurchSuite = item.Link?.Contains("churchsuite", StringComparison.OrdinalIgnoreCase) == true;
    var repeats = string.IsNullOrWhiteSpace(item.Repeats) || item.Repeats.Equals("No", StringComparison.OrdinalIgnoreCase) || item.Repeats.Equals("None", StringComparison.OrdinalIgnoreCase)
        ? null : FcText.PlainText(item.Repeats);
    <div class="fc-row" style="padding: 16px 22px; border-top: 1px solid var(--fc-line-2); gap: 16px">
        <div class="fc-date" aria-hidden="true">
            <span class="fc-date__mon">@item.Date.ToString("MMM")</span>
            <span class="fc-date__day">@item.Date.Day</span>
        </div>
        <div class="fc-event__body" style="flex: 1 1 260px">
            <span class="fc-event__name" style="font-size: 18px">@name</span>
            <span class="fc-small fc-muted">
                @item.Date.ToString("dddd d MMMM") · @FcText.TimeRange(item.StartTime, item.EndTime)@(repeats == null ? "" : " · " + repeats)
            </span>
            @if (!string.IsNullOrWhiteSpace(item.Address))
            {
                <span class="fc-tiny fc-muted">@FcText.PlainText(item.Address)</span>
            }
        </div>
        @if (fromChurchSuite)
        {
            <span class="fc-badge fc-badge--cs">ChurchSuite</span>
        }
        else
        {
            <span class="fc-badge fc-badge--moss">@Localizer["FC_ADDED_HERE"]</span>
        }
        <div class="fc-btn-row">
            <a asp-page="/Events/Edit/Index" asp-route-id="@protectedId" class="fc-btn fc-btn--quiet fc-btn--sm">@Localizer["FC_EDIT"]<span class="fc-sr-only"> @name</span></a>
            <form method="post" asp-page="/Events/Index" asp-page-handler="DeleteEvent" data-fc-confirm="@Localizer["FC_CONFIRM_DELETE_EVENT", name]">
                <input type="hidden" name="eventId" value="@protectedId" />
                <button class="fc-btn fc-btn--danger-outline fc-btn--sm" type="submit">@Localizer["FC_DELETE"]<span class="fc-sr-only"> @name</span></button>
            </form>
        </div>
    </div>
}
