@page
@model ForestChurches.Pages.Events.IndexModel
@using ForestChurches.Components.Ui
@inject ForestChurches.Components.Security.Encoder Encoder;
@{
    // Church admin pages share the account shell (top bar + sidebar).
    Layout = "/Areas/Identity/Pages/Account/Manage/_Layout.cshtml";
    ViewData["ActivePage"] = "Events";
    ViewData["Title"] = Localizer["EVENTS_PAGE_TITLE"];

    var today = DateOnly.FromDateTime(DateTime.Today);
    var all = Model.Events ?? new List<ForestChurches.Models.EventsModel>();
    var upcoming = all.Where(e => e.Date >= today).OrderBy(e => e.Date).ThenBy(e => e.StartTime).ToList();
    var past = all.Where(e => e.Date < today).OrderByDescending(e => e.Date).ToList();
    var isError = Model.StatusMessage?.StartsWith("Error", StringComparison.OrdinalIgnoreCase) == true;
}

<div class="fc-page-head">
    <div>
        <h1>@Localizer["EVENTS_PAGE_TITLE"]</h1>
        <p>@Localizer["FC_EVENTS_LEAD"]</p>
    </div>
    <div class="fc-btn-row">
        <form method="post" asp-page-handler="SyncEvents">
            <button type="submit" class="fc-btn fc-btn--quiet">@Localizer["FC_SYNC_FROM_CHURCHSUITE"]</button>
        </form>
        <a asp-page="./Add/Index" class="fc-btn fc-btn--primary">+ @Localizer["EVENTS_ADD_EVENT_BUTTON"]</a>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="fc-alert @(isError ? "fc-alert--danger" : "fc-alert--ok")" role="status">@Model.StatusMessage</div>
}

<section class="fc-card fc-card--flush" aria-labelledby="upcoming-h">
    <div class="fc-row fc-row--between" style="padding: 20px 22px 8px">
        <h2 id="upcoming-h" class="fc-h3">@Localizer["FC_UPCOMING_EVENTS"]</h2>
        <span class="fc-small fc-muted">@Localizer["FC_EVENT_COUNT", upcoming.Count]</span>
    </div>

    @if (upcoming.Count == 0)
    {
        <div class="fc-empty" style="padding-top: 24px">
            <p class="fc-muted">@Localizer["EVENTS_NO_EVENTS_TEXT"]</p>
            <p class="fc-small fc-muted" style="margin-top: 6px">@Localizer["EVENTS_CONTACT_TEXT"] <a asp-page="/Contact">@Localizer["EVENTS_CONTACT_LINK"]</a></p>
        </div>
    }
    else
    {
        <partial name="_AdminEventRows" model="upcoming" />
    }
</section>

@if (past.Count > 0)
{
    <details class="fc-card fc-card--flush">
        <summary style="padding: 18px 22px; cursor: pointer; font-weight: 700">@Localizer["FC_PAST_EVENTS", past.Count]</summary>
        <partial name="_AdminEventRows" model="past" />
    </details>
}

<p class="fc-small fc-muted"><strong>@Localizer["EVENTS_FOOTER_NOTE_TITLE"]:</strong> @Localizer["EVENTS_FOOTER_NOTE_TEXT"]</p>
