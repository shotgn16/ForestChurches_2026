@page
@model ForestChurches.Pages.SuccessModel
@{
    ViewData["Title"] = Model.SuccessInfo?.SuccessTitle;
}

<div class="fc-auth__form" style="flex: 1 0 auto; padding-top: 64px; padding-bottom: 64px">
    <div class="fc-auth__box fc-auth__box--card" role="status">
        <span class="fc-icon-tile fc-icon-tile--ok" aria-hidden="true"><svg class="fc-icon" style="width: 28px; height: 28px" viewBox="0 0 24 24"><path d="M5 12l5 5 9-10"></path></svg></span>
        <h1 style="font-size: 30px">@Model.SuccessInfo?.SuccessTitle</h1>
        <p class="fc-lead" style="font-size: 17px">@Model.SuccessInfo?.SuccessMessage</p>
        <a asp-page="/Index" class="fc-btn fc-btn--primary">@Localizer["SUCCESS_BACK_TO_HOME"]</a>
    </div>
</div>
