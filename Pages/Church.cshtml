@page
@model ForestChurches.Pages.ChurchModel
@using System.Globalization
@using ForestChurches.Components.Ui
@using ForestChurches.Components.Services
@inject ForestChurches.Components.Security.Encoder Encoder;
@inject ForestChurches.Components.Storage.IBlobUrlService BlobUrlService;
@{
    Layout = "_Layout";
    var church = Model.ChurchInformation;
    ViewData["Title"] = church != null ? FcText.PlainText(church.Name) : Localizer["FC_CHURCH_NOT_FOUND"].Value;

    var defaultSrc = BlobUrlService.GetReadSasUrl("IMGUR-1.png", TimeSpan.FromDays(7));
    // The church's own picture, else its managing account's (how single-church accounts have always worked).
    var logoBlob = !string.IsNullOrEmpty(church?.ImageBlobName) ? church!.ImageBlobName : Model.AssociatedUser?.ImageBlobName;
    var logoSrc = !string.IsNullOrEmpty(logoBlob)
        ? BlobUrlService.GetReadSasUrl(logoBlob!, TimeSpan.FromHours(1))
        : defaultSrc;

    // Services in the order they next take place; ones with no upcoming dates go last.
    var ukNow = ServiceSchedule.UkNow();
    var services = (church?.ServiceTimes ?? new List<ForestChurches.Models.ServiceTimes>())
        .Select(s => (Service: s, Upcoming: ServiceSchedule.Upcoming(s, ukNow, 6)))
        .OrderBy(x => x.Upcoming.Count > 0 ? x.Upcoming[0].SortKey : DateTime.MaxValue)
        .ThenBy(x => FcText.ServiceTimeSortKey(x.Service.Time))
        .ToList();
    var next = services.FirstOrDefault(x => x.Upcoming.Count > 0);

    // Where a service is held: its own church (nothing to say), another church on the account, or an address.
    string? HeldAt(ForestChurches.Models.ServiceTimes s) => !s.UseCustomLocation ? null
        : s.LocationChurch != null ? FcText.PlainText(s.LocationChurch.Name)
        : string.IsNullOrWhiteSpace(s.LocationAddress) ? null : FcText.PlainText(s.LocationAddress);

    var today = DateOnly.FromDateTime(DateTime.Today);
    var events = (Model.ChurchEvents ?? new List<ForestChurches.Models.EventsModel>())
        .Where(e => e.Date >= today)
        .OrderBy(e => e.Date).ThenBy(e => e.StartTime)
        .ToList();

    var facilities = church == null ? new List<string>() : new List<(bool On, string Key)>
    {
        (church.WheelchairAccess, "FC_FACT_STEP_FREE"),
        (church.Parking, "NEARME_FACILITY_PARKING"),
        (church.HearingAidSupport, "FC_FACT_HEARING_LOOP"),
        (church.Restrooms, "NEARME_FACILITY_RESTROOMS"),
        (church.Refreshments, "NEARME_FACILITY_REFRESHMENTS"),
        (church.Childcare, "FC_FACT_CHILDREN"),
        (church.Wifi, "NEARME_FACILITY_WIFI"),
        (church.Kitchen, "NEARME_FACILITY_KITCHEN"),
        (church.MeetingHall, "NEARME_FACILITY_COMMUNITY_HALL"),
        (church.WorshipHall, "NEARME_FACILITY_WORSHIP_HALL"),
        (church.OutdoorSpaces, "NEARME_FACILITY_OUTDOOR_SPACE"),
    }.Where(f => f.On).Select(f => Localizer[f.Key].Value).ToList();

    var directionsUrl = "https://www.google.com/maps/dir/?api=1&destination=" + Uri.EscapeDataString(church?.Address ?? string.Empty);
    var website = church?.Website?.ToString();
    var hasOwnWebsite = !string.IsNullOrEmpty(website) && !website.Contains("forestchurches.co.uk", StringComparison.OrdinalIgnoreCase);
    var churchsuite = church?.Churchsuite?.ToString();
    var hasChurchSuite = !string.IsNullOrEmpty(churchsuite) && !string.Equals(churchsuite.TrimEnd('/'), "https://churchsuite.com", StringComparison.OrdinalIgnoreCase);
    var hasPhone = !string.IsNullOrWhiteSpace(church?.Phone) && church!.Phone.Any(char.IsDigit) && church.Phone.Trim('0', '-', ' ').Length > 0;
}

@if (church == null)
{
    <section class="fc-container fc-section">
        <div class="fc-card fc-empty">
            <h1 class="fc-h2">@Localizer["FC_CHURCH_NOT_FOUND"]</h1>
            <p class="fc-muted" style="margin: 10px 0 20px">@Localizer["FC_CHURCH_NOT_FOUND_TEXT"]</p>
            <a class="fc-btn fc-btn--primary" asp-page="/Index">@Localizer["FC_NAV_FIND"]</a>
        </div>
    </section>
    return;
}

<section class="fc-hero fc-hero--slim" aria-labelledby="church-name">
    <img class="fc-hero__img" src="~/img/hero.jpg" alt="" />
    <div class="fc-hero__shade"></div>
    <div class="fc-container fc-hero__body">
        <img class="fc-hero__logo" image-sas="@(Model.AssociatedUser?.ImageBlobName ?? string.Empty)" src="@logoSrc" expires-minutes="60" alt="@Localizer["ALT_PROFILE_PICTURE"]" />
        <div class="fc-stack" style="flex: 1 1 400px; gap: 10px">
            <a class="fc-hero__back" asp-page="/Index" data-fc-back>@Localizer["FC_BACK"]</a>
            <h1 id="church-name">@FcText.PlainText(church.Name)</h1>
            <p style="color: #F1EEE4; font-size: 18px">@FcText.PlainText(church.Address)</p>
            @if (church.Benefice != null)
            {
                <p style="color: #F1EEE4; font-size: 16px">@Localizer["FC_BENEFICE_PART_OF", FcText.PlainText(church.Benefice.Name)]</p>
            }
            <div class="fc-row" style="gap: 8px">
                <span class="fc-badge fc-badge--glass">@FcText.PlainText(church.Denomination)</span>
                <span class="fc-badge fc-badge--glass">@Localizer["FC_CONGREGATION", FcText.PlainText(church.Congregation)]</span>
                @if (church.Status == "Open")
                {
                    <span class="fc-badge fc-badge--ok">● @Localizer["STATUS_OPEN"]</span>
                }
                else
                {
                    <span class="fc-badge fc-badge--warn">@Localizer["STATUS_CLOSED"]</span>
                }
            </div>
        </div>
    </div>
</section>

<div class="fc-container">
    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        var failed = Model.StatusMessage.StartsWith("Error", StringComparison.OrdinalIgnoreCase);
        <div class="fc-alert @(failed ? "fc-alert--danger" : "fc-alert--ok")" role="status" style="margin-top: 24px">@Model.StatusMessage</div>
    }
    <section class="fc-keyfacts" aria-label="@Localizer["FC_KEY_FACTS"]">
        <div class="fc-keyfacts__main">
            <span class="fc-keyfacts__label">@Localizer["FC_NEXT_SERVICE"]</span>
            @if (next.Service != null)
            {
                var nextWhere = HeldAt(next.Service);
                <span class="fc-keyfacts__value">@ServiceScheduleText.Occurrence(next.Upcoming[0]) · @FcText.PlainText(next.Service.Note)@(nextWhere == null ? "" : " · " + Localizer["FC_SVC_HELD_AT", nextWhere].Value)</span>
            }
            else
            {
                <span class="fc-keyfacts__value">@Localizer["FC_NO_SERVICE_TIMES"]</span>
            }
        </div>
        <div class="fc-btn-row">
            <a class="fc-btn fc-btn--primary" href="@directionsUrl" target="_blank" rel="noopener">
                <svg class="fc-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 11l18-8-8 18-2-8z"></path></svg>
                @Localizer["FC_DIRECTIONS"]<span class="fc-sr-only"> (@Localizer["FC_OPENS_NEW_TAB"])</span>
            </a>
            <a class="fc-btn fc-btn--outline" href="#contact">@Localizer["CHURCH_SEND_MESSAGE_BUTTON"]</a>
            @if (hasOwnWebsite)
            {
                <a class="fc-btn fc-btn--outline" href="@website" target="_blank" rel="noopener">@Localizer["FC_WEBSITE"]</a>
            }
            @if (hasChurchSuite)
            {
                <a class="fc-btn fc-btn--outline" href="@churchsuite" target="_blank" rel="noopener">@Localizer["CHURCH_CHURCHSUITE_BUTTON"]</a>
            }
        </div>
    </section>

    <div class="fc-columns fc-section" style="padding-top: 32px; padding-bottom: 72px">
        <div class="fc-columns__main">
            @if (!string.IsNullOrWhiteSpace(church.Description))
            {
                <section class="fc-card" aria-labelledby="about-h">
                    <h2 id="about-h" class="fc-card__title" style="font-size: 26px !important">@Localizer["FC_ABOUT_US"]</h2>
                    <p class="fc-lead" style="font-size: 18px; white-space: pre-line">@FcText.PlainText(church.Description)</p>
                </section>
            }

            <section class="fc-card" aria-labelledby="svc-h">
                <h2 id="svc-h" class="fc-card__title" style="font-size: 26px !important">@Localizer["FC_SERVICES_HEADING"]</h2>
                @if (services.Count == 0)
                {
                    <p class="fc-muted">@Localizer["FC_NO_SERVICE_TIMES"]</p>
                }
                else
                {
                    <div>
                        @foreach (var (s, upcoming) in services)
                        {
                            var heldAt = HeldAt(s);
                            <div class="fc-service fc-service--schedule">
                                <span class="fc-service__time">@ServiceScheduleText.TimeText(s)</span>
                                <div class="fc-service__body">
                                    <span class="fc-service__name">@FcText.PlainText(s.Note)</span>
                                    <span class="fc-service__rule">@ServiceScheduleText.Describe(s, Localizer)</span>
                                    @if (heldAt != null)
                                    {
                                        <span class="fc-service__where">
                                            <svg class="fc-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-7-6.5-7-12a7 7 0 0 1 14 0c0 5.5-7 12-7 12z"></path><circle cx="12" cy="9" r="2.5"></circle></svg>
                                            @if (s.LocationChurch != null && s.LocationChurch.Status == "Open")
                                            {
                                                <text>@Localizer["FC_SVC_HELD_AT_PREFIX"] <a asp-page="/Church" asp-route-id="@Model.ChurchLink(s.LocationChurch.ID)">@heldAt</a></text>
                                            }
                                            else
                                            {
                                                <text>@Localizer["FC_SVC_HELD_AT", heldAt]</text>
                                            }
                                        </span>
                                    }
                                    @if (upcoming.Count == 0)
                                    {
                                        <span class="fc-service__next fc-muted">@Localizer["FC_SVC_NO_UPCOMING"]</span>
                                    }
                                    else
                                    {
                                        <span class="fc-service__next">@Localizer["FC_SVC_NEXT_ON", ServiceScheduleText.Occurrence(upcoming[0])]</span>
                                        @if (upcoming.Count > 1)
                                        {
                                            <details class="fc-service__more">
                                                <summary>@Localizer["FC_SVC_MORE_DATES"]</summary>
                                                <ul>
                                                    @foreach (var o in upcoming.Skip(1))
                                                    {
                                                        <li>@ServiceScheduleText.Occurrence(o)</li>
                                                    }
                                                </ul>
                                            </details>
                                        }
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </section>

            <section class="fc-card" aria-labelledby="ev-h">
                <div class="fc-row fc-row--between" style="margin-bottom: 4px">
                    <h2 id="ev-h" style="font-size: 26px">@Localizer["FC_UPCOMING_EVENTS"]</h2>
                </div>
                @if (events.Count == 0)
                {
                    <p class="fc-muted" style="padding-top: 8px">@Localizer["CHURCH_NO_EVENTS_MESSAGE"]</p>
                }
                else
                {
                    @foreach (var item in events)
                    {
                        var desc = FcText.PlainText(item.Description);
                        <div class="fc-event">
                            <div class="fc-date" aria-hidden="true">
                                <span class="fc-date__mon">@item.Date.ToString("MMM")</span>
                                <span class="fc-date__day">@item.Date.Day</span>
                            </div>
                            <div class="fc-event__body">
                                <span class="fc-event__name">@FcText.PlainText(item.Name)</span>
                                <span class="fc-small fc-muted">@item.Date.ToString("dddd d MMMM") · @FcText.TimeRange(item.StartTime, item.EndTime)@(string.IsNullOrWhiteSpace(item.Repeats) || item.Repeats.Equals("No", StringComparison.OrdinalIgnoreCase) || item.Repeats.Equals("None", StringComparison.OrdinalIgnoreCase) ? "" : " · " + FcText.PlainText(item.Repeats))</span>
                                @if (!string.IsNullOrEmpty(desc))
                                {
                                    <details>
                                        <summary><span class="fc-when-closed">@Localizer["FC_READ_MORE"]</span><span class="fc-when-open">@Localizer["FC_SHOW_LESS"]</span></summary>
                                        <p>@desc</p>
                                    </details>
                                }
                            </div>
                        </div>
                    }
                }
            </section>
        </div>

        <aside class="fc-columns__side">
            @if (church.Benefice != null)
            {
                <section class="fc-card" aria-labelledby="ben-h" style="padding: 24px">
                    <h2 id="ben-h" class="fc-card__title">@FcText.PlainText(church.Benefice.Name)</h2>
                    @if (!string.IsNullOrWhiteSpace(church.Benefice.Description))
                    {
                        <p class="fc-small" style="white-space: pre-line; margin-bottom: 12px">@FcText.PlainText(church.Benefice.Description)</p>
                    }
                    @if (Model.BeneficeSiblings.Count > 0)
                    {
                        <p class="fc-small fc-muted" style="margin-bottom: 6px">@Localizer["FC_BENEFICE_SISTERS"]</p>
                        <ul class="fc-benefice-list">
                            @foreach (var sister in Model.BeneficeSiblings)
                            {
                                <li><a asp-page="/Church" asp-route-id="@Model.ChurchLink(sister.ID)">@FcText.PlainText(sister.Name)</a></li>
                            }
                        </ul>
                    }
                    @if (!string.IsNullOrWhiteSpace(church.Benefice.Website) && Uri.TryCreate(church.Benefice.Website, UriKind.Absolute, out var beneficeSite))
                    {
                        <a class="fc-btn fc-btn--outline fc-btn--sm" style="margin-top: 12px" href="@beneficeSite" target="_blank" rel="noopener">@Localizer["FC_BENEFICE_WEBSITE"]<span class="fc-sr-only"> (@Localizer["FC_OPENS_NEW_TAB"])</span></a>
                    }
                </section>
            }
            @if (facilities.Count > 0)
            {
                <section class="fc-card" aria-labelledby="fac-h" style="padding: 24px">
                    <h2 id="fac-h" class="fc-card__title">@Localizer["FC_WHAT_TO_EXPECT"]</h2>
                    <ul class="fc-facilities">
                        @foreach (var f in facilities)
                        {
                            <li><span class="fc-facilities__tick"><svg class="fc-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12l5 5 9-10"></path></svg></span>@f</li>
                        }
                    </ul>
                </section>
            }

            <section class="fc-card fc-card--flush" aria-labelledby="map-h">
                <h2 id="map-h" class="fc-card__title" style="padding: 20px 24px 0">@Localizer["FC_FIND_US"]</h2>
                @if (Model.HasLocation)
                {
                    <div id="fc-church-map" class="fc-map" role="img" aria-label="@Localizer["FC_MAP_OF", FcText.PlainText(church.Address)]"
                         data-lat="@Model.Latitude.ToString(CultureInfo.InvariantCulture)" data-lng="@Model.Longitude.ToString(CultureInfo.InvariantCulture)"
                         data-name="@FcText.PlainText(church.Name)"></div>
                }
                <div style="padding: 14px 24px 20px" class="fc-stack">
                    <p class="fc-small">@FcText.PlainText(church.Address)</p>
                    @if (hasPhone)
                    {
                        <p class="fc-small"><a href="tel:@church.Phone.Replace(" ", "")">@church.Phone</a></p>
                    }
                </div>
            </section>

            <section id="contact" class="fc-card" aria-labelledby="ct-h" style="padding: 24px">
                <h2 id="ct-h" class="fc-card__title" style="margin-bottom: 4px !important">@Localizer["CHURCH_SEND_MESSAGE_BUTTON"]</h2>
                <p class="fc-small fc-muted" style="margin-bottom: 16px">@Localizer["FC_GOES_TO_CHURCH"]</p>
                <form method="post" asp-page="/Contact" class="fc-stack" style="gap: 12px">
                    <input type="hidden" name="cid" value="@Encoder.Protect(church.ID, "fc.data.contact")" />
                    <div class="fc-field">
                        <label class="fc-label" for="ct-name">@Localizer["FC_YOUR_NAME"]</label>
                        <input class="fc-input" id="ct-name" name="Input.Name" autocomplete="name" required />
                    </div>
                    <div class="fc-field">
                        <label class="fc-label" for="ct-email">@Localizer["FC_YOUR_EMAIL"]</label>
                        <input class="fc-input" id="ct-email" name="Input.ClientEmail" type="email" autocomplete="email" required />
                    </div>
                    <div class="fc-field">
                        <label class="fc-label" for="ct-subject">@Localizer["CONTACT_SUBJECT_PLACEHOLDER"]</label>
                        <input class="fc-input" id="ct-subject" name="Input.Subject" required />
                    </div>
                    <div class="fc-field">
                        <label class="fc-label" for="ct-msg">@Localizer["CONTACT_MESSAGE_PLACEHOLDER"]</label>
                        <textarea class="fc-textarea" id="ct-msg" name="Input.Message" rows="4" required></textarea>
                    </div>
                    <button type="submit" class="fc-btn fc-btn--primary">@Localizer["CONTACT_SUBMIT_BUTTON"]</button>
                </form>
            </section>

            <section id="save" class="fc-card fc-stack" aria-labelledby="save-h" style="padding: 24px; gap: 14px">
                <div>
                    <h2 id="save-h" class="fc-card__title" style="margin-bottom: 4px !important">@Localizer["FC_SAVE_DETAILS"]</h2>
                    <p class="fc-small fc-muted">@Localizer["FC_SAVE_DETAILS_TEXT"]</p>
                </div>
                <form method="post" asp-page-handler="SendInformation" asp-route-id="@Model.ProtectedId" class="fc-stack" style="gap: 10px">
                    <div class="fc-field">
                        <label class="fc-label" for="save-email">@Localizer["FC_YOUR_EMAIL"]</label>
                        <input class="fc-input" id="save-email" name="email" type="email" autocomplete="email" value="@Model.SignedInEmail" required />
                    </div>
                    <button type="submit" class="fc-btn fc-btn--outline">@Localizer["FC_EMAIL_ME_DETAILS"]</button>
                </form>
                <form method="post" asp-page-handler="DownloadInformation" asp-route-id="@Model.ProtectedId">
                    <button type="submit" class="fc-link-btn">
                        <svg class="fc-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v12M7 10l5 5 5-5M5 21h14"></path></svg>
                        @Localizer["FC_DOWNLOAD_DETAILS"]
                    </button>
                </form>
            </section>
        </aside>
    </div>
</div>

@section Head {
    <link href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" rel="stylesheet" crossorigin="anonymous" />
}

@section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin="anonymous"></script>
    <script nonce="@HttpContextAccessor.HttpContext?.Items["CSP-Script-Nonce"]">
        document.addEventListener("DOMContentLoaded", function () {
            var el = document.getElementById("fc-church-map");
            if (el && typeof L !== "undefined") {
                var lat = parseFloat(el.getAttribute("data-lat"));
                var lng = parseFloat(el.getAttribute("data-lng"));
                var map = L.map(el, { scrollWheelZoom: false }).setView([lat, lng], 15);
                L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
                    attribution: "&copy; OpenStreetMap contributors",
                    maxZoom: 18
                }).addTo(map);
                // A vector marker: Leaflet's default PNG icons are blocked by the site's image CSP.
                L.circleMarker([lat, lng], { radius: 10, color: (getComputedStyle(document.documentElement).getPropertyValue("--fc-surface").trim() || "#ffffff"), weight: 3, fillColor: (getComputedStyle(document.documentElement).getPropertyValue("--fc-primary").trim() || "#1F3D2B"), fillOpacity: 1 })
                    .addTo(map)
                    .bindTooltip(el.getAttribute("data-name") || "", { direction: "top", offset: [0, -8] });
            }

            // "Back" returns to the previous page (e.g. search results) when it was on this site.
            var back = document.querySelector("[data-fc-back]");
            if (back && document.referrer.indexOf(window.location.origin) === 0 && window.history.length > 1) {
                back.addEventListener("click", function (e) { e.preventDefault(); window.history.back(); });
            }
        });
    </script>
}
