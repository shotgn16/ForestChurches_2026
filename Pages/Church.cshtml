@page
@inject ForestChurches.Components.Configuration.Configuration configuration;
@inject ForestChurches.Components.Security.Encoder Encoder;
@inject ForestChurches.Components.Storage.IBlobUrlService BlobUrlService;
@model ForestChurches.Pages.ChurchModel
@{
    Layout = "_Layout";
    var eventCount = Model?.ChurchEvents?.Count ?? 0;
    var defaultSrc = BlobUrlService.GetReadSasUrl("IMGUR-1.png", TimeSpan.FromDays(7));
}
<head>
    <link href="~/css2/Page-header.css" integrity="sha256-Rtz0HIcRj9MQNF8G3xzx3+XNkldfHcYBgrvQhm9r6qY=" rel="stylesheet" />
    <link href="~/css2/Church.css" integrity="sha256-W6G/2dOuJ/l5MThH2C+Af4olyq0PB+F4cq3Zn/SipAQ=" rel="stylesheet" />
    <!-- <link href="~/css2/Church.css" integrity="sha256-vOw+N7AX1jr9hKhUOnkxSuoEKfFhB8Pxg8DmCcbqCqg=" rel="stylesheet" /> -->
    <link href="~/css2/Declarations.css" integrity="sha256-b2v7B06n4c09zv1eqxFMGfVBCtakRqbLuoyHdAurYlI=" rel="stylesheet" />
    <link href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" rel="stylesheet" crossorigin="anonymous" />
</head>
<style nonce="@HttpContextAccessor.HttpContext?.Items["CSP-Style-Nonce"]">
    #noEvents {
        text-align: center;
        font-weight: bold;
        font-size: large;
        vertical-align: middle;
    }

    #map1 {
        width: 100%;
        height: 500px;
    }

    #map2 {
        height: 150px;
        width: 100vh;
    }
    img {
        max-width: clamp(8rem, 8vw, 35rem);
        border-radius: 10%;
        max-height: 50%;
        padding-top: calc(3.0rem + 1.0vw);
    }
    main {
        background-color: #00AD6A;
    }
</style>

<!-- Beginning of Page header -->
<div class="container-fluid page-hero">
    <div class="hero-text">
        <div>
            <img image-sas="@(Model.AssociatedUser?.ImageBlobName ?? string.Empty)" src="@defaultSrc" expires-minutes="60" alt="profile picture" />
        </div>
        <div class="heading-text">
            <h1>@Model.ChurchInformation?.Name</h1>
            <p>@Model.ChurchInformation?.Address</p>
        </div>
        <div class="tag-holder">
            <div class="tag"><strong>Denomination</strong> @Model.ChurchInformation?.Denomination</div>
            <div class="tag"><strong>Congregation</strong> @Model.ChurchInformation?.Congregation</div>
        </div>
    </div>
</div>

<div class="content-container">
    <main class="card-container">
        <!-- General Church Information-->
        <section class="card half-width">
            <h2>General Information</h2>
            <p><strong>Name: </strong>@Model.ChurchInformation?.Name</p>
            <p><strong>Description: </strong>@Model.ChurchInformation?.Description</p>
            <p><strong>Website: </strong><a href="@Model.ChurchInformation?.Website">@Model.ChurchInformation?.Website</a></p>
            <p><strong>Address: </strong>@Model?.ChurchInformation?.Address</p>

            <h2>Facilities</h2>
            <ul>
                <li><p><strong>Refreshments</strong> @(Model.ChurchInformation?.Refreshments == true ? "Available" : "Not available")</p></li>
                <li><p><strong>Restrooms</strong> @(Model.ChurchInformation?.Restrooms == true ? "Available" : "Not available")</p></li>
                <li><p><strong>WiFi</strong> @(Model.ChurchInformation?.Wifi == true ? "Available" : "Not available")</p></li>
                <li><p><strong>Parking</strong> @(Model.ChurchInformation?.Parking == true ? "Available" : "Not available")</p></li>
                <li><p><strong>Wheelchair</strong> @(Model.ChurchInformation?.WheelchairAccess == true ? "Available" : "Not available")</p></li>
                <li><p><strong>Community Space</strong> @(Model.ChurchInformation?.MeetingHall == true ? "Available" : "Not available")</p></li>
                <li><p><strong>Kitchen</strong> @(Model.ChurchInformation?.Kitchen == true ? "Available" : "Not available")</p></li>
                <li><p><strong>Hearing Aid Support</strong> @(Model.ChurchInformation?.HearingAidSupport == true ? "Available" : "Not available")</p></li>
                <li><p><strong>Outdoor Space</strong> @(Model.ChurchInformation?.OutdoorSpaces == true ? "Available" : "Not available")</p></li>
                <li><p><strong>Church Building</strong> @(Model.ChurchInformation?.WorshipHall == true ? "Available" : "Not available")</p></li>
                <li><p><strong>Childrens Provision</strong> @(Model.ChurchInformation?.Childcare == true ? "Available" : "Not available")</p></li>
            </ul>

            <div class="button-container">
                <a href="@Html.Encode(Model.ChurchInformation?.Churchsuite)" class="btn btn-success half-width">ChurchSuite</a>
                <form id="messageForm" action="/Contact" method="get">
                    <!-- AntiforgeryToken -->
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="cid" value="@Encoder.Protect(Model.ChurchInformation?.ID, "fc.data.contact")" />
                    <!-- Assign an id to the button -->
                    <button id="sendMessageButton" type="button" class="btn btn-primary half-width">Send a message</button>
                </form>
            </div>
        </section>

        <!-- Church Events for smaller screens -->
        <section class="card full-width events-mobile">
            <div class="list-group event-container">
                @if (Model.ChurchEvents != null && Model.ChurchEvents.Count > 0)
                {
                    foreach (var item in Model.ChurchEvents)
                    {
                        <h2>Events</h2>
                        <a href="@Html.Encode(item.Link)" class="list-group-item list-group-item-action flex-column align-items-start">
                            <div class="d-flex w-100 justify-content-between">
                                <h5 class="mb-1">@Encoder.HtmlEncode(item.Name)</h5>
                                <small>@Encoder.HtmlEncode(item.Church)</small>
                            </div>
                            <p class="list-group-item-description mb-1">@Encoder.HtmlEncode(item.Description)</p>
                            <small>@Encoder.HtmlEncode(item.Date), @Encoder.HtmlEncode(item.StartTime) - @Encoder.HtmlEncode(item.EndTime)</small>
                        </a>
                    }
                }
                else
                {
                    <p id="noEvents">No events available.</p>
                }
            </div>
        </section>

        <!-- Church Services -->
        <section class="card services-card full-width">
            <h2>Sunday Services</h2>
            <ul>
                @if (Model.ChurchInformation?.ServiceTimes != null)
                {
                    foreach (var service in Model.ChurchInformation.ServiceTimes)
                    {
                        <li>@Encoder.HtmlEncode(service.Note) @@ @Encoder.HtmlEncode(service.Time)</li>
                        <br />
                    }
                }
            </ul>
        </section>
    </main>

    <!-- Church Events for larger screens -->
    <aside class="card events">
        <div class="list-group event-container">
            @if (Model.ChurchEvents != null)
            {
                foreach (var item in Model.ChurchEvents)
                {
                    <h2>Events</h2>
                    <a href="@Html.Encode(item.Link)" class="list-group-item list-group-item-action flex-column align-items-start">
                        <div class="d-flex w-100 justify-content-between">
                            <h5 class="mb-1">@Html.Encode(item.Name)</h5>
                            <small>@Html.Encode(item.Church)</small>
                        </div>
                        <p class="list-group-item-description mb-1">@item.Description</p>
                        <small>@Html.Encode(item.Date), @Html.Encode(item.StartTime) - @Html.Encode(item.EndTime)</small>
                    </a>
                }
            }
            else if (Model.ChurchEvents == null)
            {
                <p id="noEvents">No events available.</p>
            }
        </div>

        @if (eventCount <= 2)
        {
            <h2 class="map-header">Find Us On Maps</h2>
            <section>
                <div id="map1"></div>
            </section>
        }
    </aside>
</div>

@if (eventCount > 2)
{
    <h2 class="map-header">Find Us On Maps</h2>
    <section>
        <div id="map2"></div>
    </section>
}

@section scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin="anonymous"></script>
    <script nonce="@HttpContextAccessor.HttpContext?.Items["CSP-Script-Nonce"]">
document.addEventListener("DOMContentLoaded", function () {
    var latitude = @Model.Latitude;
    var longitude = @Model.Longitude;
    var zoomLevel = (@eventCount > 2) ? 12 : 15;
    var mapId = (@eventCount > 2) ? "map2" : "map1";
    
    var map = L.map(mapId).setView([latitude, longitude], zoomLevel);
    var tileLayer = L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '&copy; OpenStreetMap contributors',
        maxZoom: 18
    }).addTo(map);

    tileLayer.on('error', function(e) {
        console.error('Tile load error:', e);
        // Fallback or alert for the user
    });

    L.marker([latitude, longitude]).addTo(map)
        .bindPopup("<b>@Model.ChurchInformation?.Name</b><br>@Model.ChurchInformation?.Address")
        .openPopup();
});
    </script>

    <script nonce="@HttpContextAccessor.HttpContext?.Items["CSP-Script-Nonce"]" crossorigin="anonymous">
       document.addEventListener("DOMContentLoaded", function() {
           var sendMessageButton = document.getElementById('sendMessageButton');
        if (sendMessageButton) {
            console.log('Button found');
                sendMessageButton.addEventListener('click', function() {
                console.log('Button clicked');
                    document.getElementById('messageForm').submit();
                });
            } else {
                console.log('Button not found');
            }
        });
    </script>
}
