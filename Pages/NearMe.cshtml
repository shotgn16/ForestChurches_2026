@page
@model ForestChurches.Pages.NearMeModel
@using ForestChurches.Components.Ui
@inject ForestChurches.Components.Security.Encoder Encoder;
@{
    Layout = "_Layout";
    ViewData["Title"] = Localizer["FC_RESULTS_TITLE"];

    var search = new ForestChurches.Models.ChurchSearchForm
    {
        Postcode = Model.Postcode,
        MaxDistanceMiles = Model.MaxDistanceMiles,
        SelectedDenomination = Model.SelectedDenomination,
        Denominations = Model.Denominations,
        Filters = new Dictionary<string, bool>
        {
            ["FilterWheelchairAccess"] = Model.FilterWheelchairAccess,
            ["FilterParking"] = Model.FilterParking,
            ["FilterHearingAidSupport"] = Model.FilterHearingAidSupport,
            ["FilterRefreshments"] = Model.FilterRefreshments,
            ["FilterChildcare"] = Model.FilterChildcare,
            ["FilterRestrooms"] = Model.FilterRestrooms,
            ["FilterWifi"] = Model.FilterWifi,
            ["FilterKitchen"] = Model.FilterKitchen,
            ["FilterMeetingHall"] = Model.FilterMeetingHall,
            ["FilterWorshipHall"] = Model.FilterWorshipHall,
            ["FilterOutdoorSpaces"] = Model.FilterOutdoorSpaces,
        }
    };

    var message = TempData["Message"] as string;
    var places = Model._places ?? new List<ForestChurches.Models.ChurchInformation>();
    var events = Model._events ?? new List<ForestChurches.Models.EventsModel>();
    var distanceLabel = (Model.MaxDistanceMiles ?? 5.0).ToString("0.#");

    // The church's next service from its schedules, e.g. "Sun 1 Nov, 10:30 · Holy Communion".
    var ukNow = ForestChurches.Components.Services.ServiceSchedule.UkNow();
    string NextService(ForestChurches.Models.ChurchInformation c)
    {
        var next = ForestChurches.Components.Services.ServiceSchedule.NextAcross(c.ServiceTimes ?? new List<ForestChurches.Models.ServiceTimes>(), ukNow);
        if (next == null) return string.Empty;
        var (service, o) = next.Value;
        var when = ForestChurches.Components.Services.ServiceScheduleText.ShortDate(o.Date) + (o.Time is { } t ? ", " + t.ToString("HH:mm") : "");
        return $"{when} · {FcText.PlainText(service.Note)}";
    }
}

<section class="fc-container fc-section--tight" aria-labelledby="page-title" style="padding-top: 40px">
    <div class="fc-stack">
        <div>
            <p class="fc-eyebrow">@Localizer["FC_HERO_EYEBROW"]</p>
            <h1 id="page-title" class="fc-h2" style="margin-top: 6px">@Localizer["NEARME_FIND_CHURCH_HEADING"]</h1>
        </div>
        @if (!string.IsNullOrEmpty(message))
        {
            <div class="fc-alert fc-alert--warn" role="alert">@message</div>
        }
        <partial name="_ChurchSearch" model="search" />
    </div>
</section>

@if (Model.ShowPlacesModal)
{
    <section class="fc-container fc-section--tight" aria-labelledby="results-title" aria-live="polite">
        <h2 id="results-title" class="fc-h2" style="margin-bottom: 20px">
            @if (places.Count == 1)
            {
                @Localizer["FC_RESULTS_ONE", distanceLabel]
            }
            else
            {
                @Localizer["FC_RESULTS_MANY", places.Count, distanceLabel]
            }
        </h2>

        @if (places.Count == 0)
        {
            <div class="fc-card fc-empty">
                <h3 class="fc-h3">@Localizer["FC_NO_RESULTS_TITLE"]</h3>
                <p class="fc-muted" style="margin-top: 8px">@Localizer["FC_NO_RESULTS_TEXT"]</p>
            </div>
        }
        else
        {
            <div class="fc-results">
                <div class="fc-results__list">
                    @foreach (var church in places)
                    {
                        var protectedId = Encoder.Protect(church.ID, "fc.data.church.information");
                        var next = NextService(church);
                        Model.PlaceDistanceMiles.TryGetValue(church.ID, out var miles);
                        <article class="fc-result">
                            <div class="fc-result__img fc-result__img--logo" aria-hidden="true"><img src="~/img/logo.png" alt="" width="96" height="59" /></div>
                            <div class="fc-result__body">
                                <div class="fc-result__head">
                                    <h3 class="fc-result__title">@FcText.PlainText(church.Name)</h3>
                                    <span class="fc-result__dist">@miles.ToString("0.0") @Localizer["FC_MILES_SHORT"]</span>
                                </div>
                                <p class="fc-small fc-muted">@FcText.PlainText(church.Denomination) · @FcText.PlainText(church.Address)</p>
                                @if (church.Benefice != null)
                                {
                                    <p class="fc-small">@Localizer["FC_BENEFICE_PART_OF", FcText.PlainText(church.Benefice.Name)]</p>
                                }
                                @if (!string.IsNullOrEmpty(next))
                                {
                                    <p><strong>@Localizer["FC_NEXT_SERVICE"]:</strong> @next</p>
                                }
                                else if (!string.IsNullOrWhiteSpace(church.Description))
                                {
                                    <p class="fc-small">@FcText.Excerpt(church.Description, 140)</p>
                                }
                                <partial name="_FacilityFacts" model="church" />
                                <div class="fc-btn-row" style="margin-top: 4px">
                                    <a class="fc-btn fc-btn--primary" asp-page="/Church" asp-route-id="@protectedId">@Localizer["FC_VIEW_CHURCH"]</a>
                                    <a class="fc-btn fc-btn--outline" href="https://www.google.com/maps/dir/?api=1&destination=@Uri.EscapeDataString(church.Address ?? string.Empty)" target="_blank" rel="noopener">@Localizer["FC_DIRECTIONS"]<span class="fc-sr-only"> (@Localizer["FC_OPENS_NEW_TAB"])</span></a>
                                    <form method="post" asp-page="/Church" asp-page-handler="DownloadInformation" asp-route-id="@protectedId">
                                        <button type="submit" class="fc-link-btn">@Localizer["FC_DOWNLOAD_DETAILS"]<span class="fc-sr-only"> – @FcText.PlainText(church.Name)</span></button>
                                    </form>
                                    <a class="fc-link-btn" asp-page="/Church" asp-route-id="@protectedId" asp-fragment="save">@Localizer["FC_EMAIL_ME_DETAILS"]<span class="fc-sr-only"> – @FcText.PlainText(church.Name)</span></a>
                                </div>
                            </div>
                        </article>
                    }
                </div>
                @if (Model.PlaceCoordinates.Count > 0)
                {
                    <div class="fc-results__map">
                        <div id="fc-results-map" class="fc-map fc-map--tall" role="img" aria-label="@Localizer["FC_RESULTS_MAP"]"
                             data-points="@System.Text.Json.JsonSerializer.Serialize(places.Where(p => Model.PlaceCoordinates.ContainsKey(p.ID)).Select(p => new { lat = Model.PlaceCoordinates[p.ID].Lat, lng = Model.PlaceCoordinates[p.ID].Lng, name = FcText.PlainText(p.Name) }))"
                             data-home="@(Model.SearchCoordinates is { } home ? System.Text.Json.JsonSerializer.Serialize(new { lat = home.Lat, lng = home.Lng }) : "")"></div>
                    </div>
                }
            </div>
        }
    </section>
}

<section id="events" class="fc-container fc-section" aria-labelledby="events-title">
    <div class="fc-card">
        <h2 id="events-title" class="fc-h3" style="font-size: 26px !important">@Localizer["NEARME_EVENTS_HEADING"]</h2>
        <p class="fc-muted" style="margin: 6px 0 18px">@Localizer["NEARME_EVENTS_INTRO_TEXT"]</p>
        <form method="post" asp-page-handler="EventForm" asp-fragment="events">
            <div class="fc-grid">
                <div class="fc-field">
                    <label class="fc-label" for="ev-postcode">@Localizer["NEARME_POSTCODE_LABEL"]</label>
                    <input class="fc-input" id="ev-postcode" name="Postcode" value="@Model.Postcode" autocomplete="postal-code" required placeholder="@Localizer["NEARME_POSTCODE_PLACEHOLDER"]" />
                </div>
                <div class="fc-field">
                    <label class="fc-label" for="ev-church">@Localizer["NEARME_CHURCH_LABEL"]</label>
                    <select class="fc-select" id="ev-church" name="SelectedChurch">
                        <option value="">@Localizer["NEARME_ANY_CHURCH_OPTION"]</option>
                        @foreach (var c in Model.ChurchNames ?? new List<string>())
                        {
                            <option value="@c" selected="@(c == Model.SelectedChurch)">@c</option>
                        }
                    </select>
                </div>
                <div class="fc-field">
                    <label class="fc-label" for="ev-from">@Localizer["NEARME_START_DATE_LABEL"]</label>
                    <input class="fc-input" id="ev-from" name="EventStartDate" type="date" value="@Model.EventStartDate?.ToString("yyyy-MM-dd")" />
                </div>
                <div class="fc-field">
                    <label class="fc-label" for="ev-to">@Localizer["NEARME_END_DATE_LABEL"]</label>
                    <input class="fc-input" id="ev-to" name="EventEndDate" type="date" value="@Model.EventEndDate?.ToString("yyyy-MM-dd")" />
                </div>
            </div>
            <input type="hidden" name="MaxDistanceMiles" value="@((Model.MaxDistanceMiles ?? 5.0).ToString(System.Globalization.CultureInfo.InvariantCulture))" />
            <div class="fc-btn-row" style="margin-top: 16px">
                <button type="submit" class="fc-btn fc-btn--primary">@Localizer["FC_FIND_EVENTS"]</button>
                <button type="button" class="fc-link-btn" data-fc-geo="/NearMe?handler=GetAddress" data-fc-geo-target="ev-postcode" data-busy="@Localizer["FC_FINDING_YOU"]">@Localizer["NEARME_USE_MY_LOCATION_BUTTON"]</button>
            </div>
        </form>

        @if (Model.ShowEventsModal)
        {
            <div aria-live="polite" style="margin-top: 24px; border-top: 1px solid var(--fc-line); padding-top: 8px">
                @if (events.Count == 0)
                {
                    <p class="fc-muted" style="padding: 16px 0">@Localizer["NEARME_NO_EVENTS_FOUND"]</p>
                }
                else
                {
                    @foreach (var ev in events)
                    {
                        var desc = FcText.PlainText(ev.Description);
                        <div class="fc-event">
                            <div class="fc-date" aria-hidden="true">
                                <span class="fc-date__mon">@ev.Date.ToString("MMM")</span>
                                <span class="fc-date__day">@ev.Date.Day</span>
                            </div>
                            <div class="fc-event__body">
                                <span class="fc-event__name">@FcText.PlainText(ev.Name)</span>
                                <span class="fc-small fc-muted">@ev.Date.ToString("dddd d MMMM") · @FcText.TimeRange(ev.StartTime, ev.EndTime)</span>
                                <span class="fc-small fc-muted">@FcText.PlainText(ev.Church) · @FcText.PlainText(ev.Address)</span>
                                @if (!string.IsNullOrEmpty(desc))
                                {
                                    <details>
                                        <summary><span class="fc-when-closed">@Localizer["FC_READ_MORE"]</span><span class="fc-when-open">@Localizer["FC_SHOW_LESS"]</span></summary>
                                        <p>@desc</p>
                                    </details>
                                }
                            </div>
                        </div>
                    }
                }
            </div>
        }
    </div>
</section>

@section Head {
    @if (Model.PlaceCoordinates.Count > 0)
    {
        <link href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" rel="stylesheet" crossorigin="anonymous" />
    }
}
@section Scripts {
    @if (Model.PlaceCoordinates.Count > 0)
    {
        <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin="anonymous"></script>
        <script src="~/js/results-map.js" asp-append-version="true"></script>
    }
}
